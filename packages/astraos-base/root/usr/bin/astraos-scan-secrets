#!/bin/sh
# astraos-scan-secrets - report credentials that must never ship inside the image.
#
# WHY THIS EXISTS (plan §10.4, §13.1)
#   The image must contain no shared password, no pre-installed account and no private
#   key. config/hooks/live/0500-security.hook.chroot runs this before the image is packed
#   and refuses the build when a key is found.
#
# WHY IT TESTS THE SHAPE OF A KEY INSTEAD OF A STRING
#   The check used to be `grep -rlq 'BEGIN PGP PRIVATE KEY' /etc` inside the hook. That
#   version failed a real build on a Debian file which merely *names* the armor format,
#   and it printed the pattern it had searched for rather than the file that matched, so
#   the build stopped with nothing to act on. A text search cannot tell a leaked key from
#   documentation, from a compiled-in parser constant, or from a magic(5) database entry.
#   An armored key has a shape, so this tool tests the shape:
#
#     * a line that is exactly an armor header, and
#     * before the block ends, either the matching footer line or at least one line of
#       base64 payload.
#
#   Files that only mention the format are printed as notes and do not fail the scan.
#   Everything that matches is printed with its path, and with the dpkg owner when it has
#   one, so a failure always names the file that caused it.
#
# SCOPE
#   /etc /root /home /srv /opt /usr/local /var/lib /usr/share/astraos by default.
#   /usr/share/doc is deliberately out of scope: Debian ships *example* keys in the
#   documentation of some packages, and a sample in a manual is not a credential.
#   A key sealed inside an archive or a compiled blob is not detected either; both gaps are
#   recorded in docs/KNOWN_LIMITATIONS.md.
#
# USAGE
#   astraos-scan-secrets [--root DIR] [DIRECTORY ...]
#
#   DIRECTORY arguments replace the default list and are read relative to --root.
#
# EXIT STATUS
#   0  no armored private key found
#   1  at least one armored private key found
#   2  the arguments or the environment were wrong

set -eu

PROGRAM='astraos-scan-secrets'
ROOT='/'

# An armored key *mentions* this text somewhere in a line. Matching this is cheap and it is
# what makes files such as a magic(5) entry or a parser constant visible at all; the awk
# program below then decides whether the mention is a key or merely a mention.
MENTION_PATTERN='BEGIN [A-Z0-9 ]*(PRIVATE|SECRET) KEY'

# The shapes an armored private key can take:
#   -----BEGIN PGP PRIVATE KEY BLOCK-----      GnuPG
#   -----BEGIN RSA PRIVATE KEY-----            PKCS#1, PKCS#3
#   -----BEGIN PRIVATE KEY-----                PKCS#8, no algorithm prefix
#   -----BEGIN ENCRYPTED PRIVATE KEY-----      encrypted PKCS#8
#   -----BEGIN OPENSSH PRIVATE KEY-----        OpenSSH
#   -----BEGIN SSH2 ENCRYPTED PRIVATE KEY----- SSH2
#   -----BEGIN PGP SECRET KEY BLOCK-----       GnuPG, pre-2.0 spelling
# `[A-Z0-9 ]*` covers all of the algorithm and "ENCRYPTED" prefixes, and matches the empty
# prefix of the bare PKCS#8 form, which the previous fixed list of patterns missed.
SCAN_PROGRAM='
BEGIN { open_block = 0; payload_lines = 0; reported = 0 }
function is_header(line) { return line ~ /^-----BEGIN [A-Z0-9 ]*(PRIVATE|SECRET) KEY( BLOCK)?-----[[:space:]]*$/ }
function is_footer(line) { return line ~ /^-----END [A-Z0-9 ]*(PRIVATE|SECRET) KEY( BLOCK)?-----[[:space:]]*$/ }
function is_payload(line) { return line ~ /^[A-Za-z0-9+\/]{16,}={0,2}[[:space:]]*$/ }
function is_checksum(line) { return line ~ /^=[A-Za-z0-9+\/]{4}[[:space:]]*$/ }
function report(kind) { if (!reported) { printf "%s\n", kind; reported = 1 } }
{
    if (open_block) {
        if (is_payload($0)) { payload_lines++; next }
        # GnuPG writes a four-character checksum on its own line before the footer; it is
        # part of the block, so it must not be read as the line that ends it.
        if (is_checksum($0) && payload_lines > 0) { next }
        if (is_footer($0)) { report("key-block"); exit }
        if ($0 ~ /^[[:space:]]*$/) { next }
        if (payload_lines > 0) { report("key-payload"); exit }
        open_block = 0; payload_lines = 0
    }
    if (!reported && is_header($0)) { open_block = 1; payload_lines = 0 }
}
END { if (!reported && open_block && payload_lines > 0) report("key-payload") }
'

usage() {
    printf '%s\n' \
        "usage: ${PROGRAM} [--root DIR] [DIRECTORY ...]" \
        "" \
        "Report files that contain an armored private key (PGP, PEM/PKCS#1, PKCS#8, SSH2)." \
        "" \
        "  --root DIR   scan inside DIR instead of /, for checking a tree before it is packed" \
        "  DIRECTORY    scan these directories instead of:" \
        "                 etc root home srv opt usr/local var/lib usr/share/astraos" \
        "  -h, --help   print this text" \
        "" \
        "Every file that is reported is printed with its path, so a failure names the cause."
}

die() { printf '%s: %s\n' "$PROGRAM" "$*" >&2; exit 2; }

while [ "$#" -gt 0 ]; do
    case $1 in
        --root)
            [ "$#" -ge 2 ] || die '--root needs a directory'
            ROOT=$2
            shift 2
            ;;
        --root=*)
            ROOT=${1#--root=}
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

[ -n "$ROOT" ] || die '--root needs a directory'
[ -d "$ROOT" ] || die "not a directory: $ROOT"
ROOT=${ROOT%/}

# A directory that was asked for explicitly and does not exist is an error. Reporting
# "clean" for a directory that was never read is the kind of check that cannot fail, which
# is worse than no check at all.
for relative in "$@"; do
    [ -e "${ROOT}/${relative#/}" ] || die "not found: ${ROOT}/${relative#/}"
done

NOTES=$(mktemp 2>/dev/null) || die 'cannot create a temporary file'
trap 'rm -f "$NOTES"' EXIT HUP INT TERM
: >"$NOTES"

# Files whose content names the armor format. Recursive grep also finds matches inside
# binary files, which is deliberate: a compiled-in constant is then reported as a note
# rather than being silently invisible.
candidates() {
    if [ "$#" -gt 0 ]; then
        for relative in "$@"; do
            grep -rl -E "$MENTION_PATTERN" -- "${ROOT}/${relative#/}" 2>/dev/null || true
        done
    else
        for relative in etc root home srv opt usr/local var/lib usr/share/astraos; do
            [ -d "${ROOT}/${relative}" ] || continue
            grep -rl -E "$MENTION_PATTERN" -- "${ROOT}/${relative}" 2>/dev/null || true
        done
    fi
}

# dpkg knows which package owns a path, and naming the package is what turns a report into
# something that can be fixed.
owner_suffix() {
    if command -v dpkg-query >/dev/null 2>&1; then
        owner=$(dpkg-query -S "$1" 2>/dev/null | head -n 1 | cut -d: -f1) || owner=''
        if [ -n "$owner" ]; then
            printf ' (dpkg: %s)' "$owner"
        fi
    fi
    return 0
}

findings=0
mentions=0
examined=0

while IFS= read -r file; do
    [ -n "$file" ] || continue
    examined=$((examined + 1))

    kind=''
    if grep -qI -E "$MENTION_PATTERN" -- "$file" 2>/dev/null; then
        kind=$(awk "$SCAN_PROGRAM" "$file" 2>/dev/null || true)
    else
        # `grep -I` treats a binary file as no match. A binary cannot carry an armored key
        # block, and the text these files contain is a program constant or a data table.
        kind='binary'
    fi

    case $kind in
        key-block)
            findings=$((findings + 1))
            printf '%s: FINDING a private key block in %s%s\n' "$PROGRAM" "$file" "$(owner_suffix "$file")"
            ;;
        key-payload)
            findings=$((findings + 1))
            printf '%s: FINDING private key material in %s%s\n' "$PROGRAM" "$file" "$(owner_suffix "$file")"
            ;;
        *)
            mentions=$((mentions + 1))
            printf '%s\n' "$file" >>"$NOTES"
            ;;
    esac
done <<EOF
$(candidates "$@")
EOF

if [ "$mentions" -gt 0 ]; then
    printf '%s: %s file(s) name a private key armor format without containing one:\n' \
        "$PROGRAM" "$mentions"
    while IFS= read -r path; do
        printf '  %s%s\n' "$path" "$(owner_suffix "$path")"
    done <"$NOTES"
fi

if [ "$findings" -gt 0 ]; then
    printf '%s: FAILED: %s file(s) contain an armored private key\n' "$PROGRAM" "$findings"
    exit 1
fi

printf '%s: no armored private key found (checked %s file(s) under %s)\n' "$PROGRAM" "$examined" "$ROOT"
