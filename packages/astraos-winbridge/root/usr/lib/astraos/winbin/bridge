cmd_shutdown() {
    _action=""; _delay=0; _abort=""
    _next="none"
    for _a in "$@"; do
        case "$_next" in
            seconds) _delay="$_a"; _next="none"; continue ;;
        esac
        case "$_a" in
            /[Ss]) _action="poweroff" ;;
            /[Rr]) _action="reboot" ;;
            /[Hh]) _action="suspend" ;;
            /[Ll]) _action="logoff" ;;
            /[Aa]) _abort=1 ;;
            /[Tt]) _next="seconds" ;;
            *) : ;;
        esac
    done
    if [ -n "$_abort" ]; then
        _pidfile="/run/astraos-shutdown.pid"
        [ -r "$_pidfile" ] || _pidfile="${TMPDIR:-/tmp}/astraos-shutdown.pid"
        if [ -r "$_pidfile" ] && kill "$(cat "$_pidfile" 2>/dev/null)" 2>/dev/null; then
            ok "The scheduled shutdown was aborted."
            return 0
        fi
        warn "No shutdown scheduled by this bridge is pending."
        return 0
    fi
    if [ -z "$_action" ]; then
        say "shutdown /s | /r | /l   (/t seconds to wait, /a aborts a scheduled one)"
        return 2
    fi
    if [ "$_action" = "logoff" ]; then
        exec xfce4-session-logout --logout --fast
    fi
    case "$_delay" in
        ''|*[!0-9]*) _delay=0 ;;
    esac
    if [ "$_delay" -gt 0 ]; then
        say "Shutting down ($_action) in ${_delay}s. Run  shutdown /a  to abort."
        printf '%s' "$$" > "${TMPDIR:-/tmp}/astraos-shutdown.pid" 2>/dev/null || true
        sleep "$_delay"
    fi
    case "$_action" in
        suspend) exec systemctl suspend ;;
        *)       exec systemctl "$_action" ;;
    esac
}

cmd_logoff() {
    exec xfce4-session-logout --logout --fast
}

cmd_runas() {
    _user=""
    while [ $# -gt 0 ]; do
        case "$1" in
            /[Uu][Ss][Ee][Rr]:*) _user="${1#/[Uu][Ss][Ee][Rr]:}" ;;
            /[Nn][Oo][Pp][Rr][Oo][Ff][Ii][Ll][Ee]|/[Ss][Aa][Vv][Ee][Cc][Rr][Ee][Dd]|/[Ee][Nn][Vv]) : ;;
            *) break ;;
        esac
        shift
    done
    if [ -z "$_user" ]; then
        say "runas /user:NAME COMMAND"
        return 2
    fi
    hint "runas -> sudo (the administrator account is 'root'; your account uses sudo)"
    case "$_user" in
        [Aa][Dd][Mm][Ii][Nn][Ii][Ss][Tt][Rr][Aa][Tt][Oo][Rr]|[Rr][Oo][Oo][Tt])
            exec sudo "$@"
            ;;
        *) exec sudo -u "$_user" "$@" ;;
    esac
}

cmd_winget() {
