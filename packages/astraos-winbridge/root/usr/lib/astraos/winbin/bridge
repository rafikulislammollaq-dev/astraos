        [Uu][Nn][Ii][Nn][Ss][Tt][Aa][Ll][Ll]) exec astra remove "$@" ;;
        [Ss][Ee][Aa][Rr][Cc][Hh]|[Ss][Hh][Oo][Ww]) exec astra search "$@" ;;
        [Uu][Pp][Gg][Rr][Aa][Dd][Ee]|[Uu][Pp]) exec astra update ;;
        *) hint "winget -> astra"; exec astra "$_sub" "$@" ;;
    esac
}

cmd_choco() {
    _sub="${1:-install}"
    shift 2>/dev/null || true
    case "$_sub" in
