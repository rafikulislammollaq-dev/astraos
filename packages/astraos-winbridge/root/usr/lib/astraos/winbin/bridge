cmd_start() {
    # start "" "TARGET": the empty first argument is the window title on
    # Windows; drop it here.
    if [ "${1:-}" = "" ] && [ $# -gt 1 ]; then
        shift
    fi
    [ $# -eq 0 ] && exec thunar "$HOME"
    _t="$1"
    shift
    case "$_t" in
        [Hh][Tt][Tt][Pp]*|[Ff][Ii][Ll][Ee]:*) exec xdg-open "$_t" ;;
        /*|~*) exec xdg-open "$(winpath "$_t")" ;;
        *\\*) exec xdg-open "$(winpath "$_t")" ;;
        *)
            if command -v "$_t" >/dev/null 2>&1; then
                setsid "$_t" "$@" >/dev/null 2>&1 &
                return 0
            fi
            if [ -e "$_t" ]; then
                exec xdg-open "$_t"
            fi
            exec xdg-open "$(winpath "$_t")"
            ;;
    esac
}

