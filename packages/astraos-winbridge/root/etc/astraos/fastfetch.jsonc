// /etc/astraos/fastfetch.jsonc
//
// The system summary 'fastfetch' prints in the first terminal window of a
// session (see interactive.sh) and for 'astra info'. Kept system-wide rather
// than in /etc/skel so every user gets updates with the package and there is
// exactly one file to theme.
//
// Colours follow the AstraOS palette (config/branding.env): magenta 95,
// cyan 96, dim 2. The 40/42 colour blocks at the bottom are the terminal
// palette test, which doubles as a "does my neon terminal work" check.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "95",
            "title": "1;95"
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[1;95m   ◢◤ A S T R A   O S \u001b[0m \u001b[2m{version}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[2m   ──────────────────────────────────────\u001b[0m"
        },
        "break",
        "os",
        "kernel",
        "packages",
        "shell",
        "de",
        "wm",
        "terminal",
        "break",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "break",
        "localIp",
        "uptime",
        "break",
        {
            "type": "colors",
            "paddingLeft": 3,
            "symbol": "block"
        }
    ]
}
