#!/bin/sh
# astraos-branding post-installation script.
#
# Registers the theme files with the components that consume them. Every step is
# guarded: a missing optional component must not fail the package installation, because
# astraos-branding is also installable on a system without a boot splash.

set -e

PREFIX='[astraos-branding]'

warn() { echo "${PREFIX} $*" >&2; }

# --- Plymouth boot splash -----------------------------------------------------
# NOT selected here. `plymouth-set-default-theme` rewrites /etc/plymouth/plymouthd.conf,
# which the plymouth package owns as a configuration file, and this script runs inside the
# very same dpkg run that configures plymouth. dpkg had already unpacked its copy of that
# file, found a different one on disk when it came to configure the package, and stopped to
# ask which version to keep:
#
#   Configuration file '/etc/plymouth/plymouthd.conf'
#   *** plymouthd.conf (Y/I/N/O/D/Z) [default=N] ? dpkg: error processing package
#     plymouth (--configure): end of file on stdin at conffile prompt
#
# Nothing answers that question while an image is being built, so the build failed after
# the whole base system had been installed. The theme is selected by
# config/live-build/config/hooks/live/0120-plymouth.hook.chroot, which runs after every
# package is installed and configured. See docs/KNOWN_LIMITATIONS.md §3.13.

# --- Icon theme cache ---------------------------------------------------------
# The icon theme is only found by applications once the index is registered.
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    if [ -f /usr/share/icons/AstraOS/index.theme ]; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/AstraOS >/dev/null 2>&1 \
            || warn "gtk-update-icon-cache reported a problem for the AstraOS theme"
    fi
fi

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi

# --- GRUB theme ---------------------------------------------------------------
# The GRUB theme is installed as an unprivileged file tree in /usr/share/astraos and
# copied into /boot by the AstraOS grub configuration. It is deliberately NOT copied
# into /boot here: writing to /boot from a package postinst can fail on a system whose
# /boot is full or mounted read-only, and a failure there would leave a half-installed
# package. The image build and the bootloader configuration handle that.

# --- Xfce icon theme preference ----------------------------------------------
# Do not edit user configuration from a package script. The defaults are shipped through
# /etc/skel by astraos-desktop, which applies to every account created afterwards.

exit 0
