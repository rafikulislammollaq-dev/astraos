#!/usr/bin/python3
# astra-ai - the AstraOS assistant on the command line.
#
# Why this exists:
#
#     The assistant is a small language model running on this machine. It has
#     no account, no service and no network of its own: the model is a file,
#     the actions are the functions in /usr/lib/astraos/ai/actions.py, and
#     everything that touches the desktop goes through the tools the desktop
#     already uses (xfconf, pactl, xdotool, wmctrl, nmcli). This command is the
#     plain way in, for the terminal and for the troubleshooting that happens
#     when a graphical front end will not start.
#
# Design rules, matching the rest of AstraOS:
#
#   * Nothing runs until it is asked. No unit, no autostart, no daemon: the
#     model server starts on the first question and `astra-ai stop` ends it.
#   * A destructive plan - suspend, reboot, shutdown, close a window, run a
#     command - is refused unless the person at the terminal says yes. The
#     model produces the plan; it can never confirm it.
#   * No root and no sudo, anywhere. Model downloads and builds go under
#     $HOME, and this file does not look for a way around that.
#   * stdout carries answers and results; stderr carries what the assistant is
#     doing. Piping `astra-ai ask ...` into another command gets the answer
#     only.
#   * Every failure is one line naming the fix, never a traceback.
#
# Why the web interface is imported inside cmd_serve() and not at the top:
#
#     astraos.ai.server is a separate module that the assistant package does
#     not own. Importing it at start-up would make every subcommand fail on a
#     system where it is not installed, and would make this file's help and
#     `astra-ai status` unusable exactly when something is missing. It is
#     imported when `serve` is typed, and the error when it is absent says so
#     in one line.

from __future__ import annotations

import argparse
import inspect
import json
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

# The package lives in /usr/lib in the image and in packages/*/root/usr/lib in
# the repository; both are one directory above this file's parent. Appended
# rather than prepended: /usr/lib is not a Python package directory, and
# nothing here should be able to shadow the standard library.
_LIB = Path(__file__).resolve().parents[1] / "lib"
if str(_LIB) not in sys.path:
    sys.path.append(str(_LIB))

from astraos.ai import actions, config, llm  # noqa: E402
from astraos.ai import eval as ai_eval  # noqa: E402
from astraos.ai import machine  # noqa: E402
from astraos.ai import prompt as ai_prompt  # noqa: E402
from astraos.ai import setup as ai_setup  # noqa: E402
from astraos.ai import tiers  # noqa: E402
from astraos.ai import voice  # noqa: E402
from astraos.ai import worker as ai_worker  # noqa: E402


def _note(message: str) -> None:
    print(f"astra-ai: {message}", file=sys.stderr)


def _engine() -> llm.Engine:
    return llm.Engine(config.load_settings())


# ---------------------------------------------------------------------------
# setup
# ---------------------------------------------------------------------------


def cmd_setup(args: argparse.Namespace) -> int:
    if args.list:
        _print_catalog()
        return 0
    if args.model:
        ai_setup.install_model(args.model)
        return 0
    if args.build:
        ai_setup.build_tools(args.build, args.variant or ai_setup.DEFAULT_VARIANT)
        return 0
    if args.voice:
        _setup_voice()
        return 0
    _print_overview()
    return 0


def _setup_voice() -> None:
    """`astra-ai setup --voice`: the two halves of talking to this machine.

    Listening is whisper.cpp, which is a build; speaking is espeak-ng, which
    is a package. The build happens only when the program is missing, so a
    second run does not clone or rebuild anything (and does not need a network
    for a git pull it would not have done). Installing a package needs root,
    so the speaking half is named and left to the person, in one line.
    """
    if voice.stt_available():
        print("listening: ready (whisper.cpp and a speech model are installed)")
    else:
        if voice.stt_binary() is None:
            ai_setup.build_tools("whisper")
        else:
            print("listening: whisper.cpp is built; a speech model is still missing")
        print("listening: install a model with:  astra-ai setup --model whisper-tiny.en")

    if voice.tts_available():
        tool = Path(voice.tts_tool() or "").name or "a speech tool"
        print(f"speaking: ready ({tool})")
    else:
        print("speaking: install espeak-ng with:  astra install espeak-ng")


def _print_catalog() -> None:
    print("models that can be installed (1B-3B parameters, Q4, CPU only):\n")
    for name, entry in ai_setup.MODELS.items():
        marker = " (recommended)" if name == ai_setup.RECOMMENDED else ""
        print(f"  {name}{marker}")
        print(f"      {entry['note']}, about {entry['size_mb']} MB")
    print("\ninstall one with:  astra-ai setup --model qwen2.5-1.5b-instruct-q4_k_m")


def _print_overview() -> None:
    info = ai_setup.describe()

    print("AstraOS assistant\n")
    print(f"  model          {info['model'] or 'none installed'}")
    print(f"  llama-server   {info['llama_server'] or 'not installed'}")
    print(f"  speech         {info['tts_tool'] or 'not installed'}")
    print(f"  transcription  {'ready' if info['stt'] else 'not installed'}")
    print(f"  models kept in {info['models_dir']}")
    print(f"  settings       {info['config_file']}")

    if info["installed"]:
        print("\n  files in the model directory:")
        for name in info["installed"]:
            print(f"    {name}")

    print("\nnext steps (each one is optional, and nothing is downloaded by itself):")
    if not info["llama_server"]:
        print("  astra-ai setup --build llama     build llama.cpp for this CPU "
              "(the avx build; --variant avx2 or auto for newer CPUs)")
    if not info["model_present"]:
        print("  astra-ai setup --model qwen2.5-1.5b-instruct-q4_k_m    download "
              "the recommended model")
    if not info["tts"]:
        print("  astra install espeak-ng         speak answers out loud")
    if not info["stt"]:
        print("  astra-ai setup --build whisper   build whisper.cpp, then install "
              "a whisper model")
    if info["llama_server"] and info["model_present"]:
        print("  astra-ai ask 'what time is it'   ask something")
        print("  astra-ai serve                    the web interface, on "
              "127.0.0.1 only")


# ---------------------------------------------------------------------------
# asking
# ---------------------------------------------------------------------------


def _ask_model(engine: llm.Engine, text: str, history: list[dict], raw: bool) -> str:
    """Ask and return the model's whole reply, streaming it only when asked.

    Streaming is off by default because the reply is usually a JSON plan, and
    watching a plan arrive one token at a time is not the answer the user
    asked for. --stream exists for debugging a model that will not follow the
    format.
    """
    messages = ai_prompt.build_messages(text, history)
    _note("asking the model (a few seconds on a CPU with AVX but no AVX2)")
    pieces: list[str] = []
    for piece in engine.ask(messages, stream=True):
        pieces.append(piece)
        if raw:
            sys.stdout.write(piece)
            sys.stdout.flush()
    if raw:
        print()
    return "".join(pieces)


def _handle_reply(reply: str, interactive: bool) -> int:
    """Print an answer, or run one action - after the user's yes when needed."""
    plan = actions.parse_plan(reply)
    if plan is None:
        # Not a plan: the model answered in prose. That is a perfectly good
        # answer, and refusing to show it would be worse than showing it.
        print(reply.strip())
        return 0

    if "answer" in plan:
        print(plan["answer"])
        return 0

    name = plan["action"]
    action = actions.ACTIONS[name]
    _note(f"action {name}: {action.summary}")

    if action.needs_confirm and not interactive:
        result = actions.execute(plan, confirmed=False)
        print(result["output"])
        _note("run it with `astra-ai chat` to confirm it here, or do it yourself")
        return 0

    confirmed = not action.needs_confirm
    if action.needs_confirm:
        print(f"astra-ai: '{name}' {action.summary}. This cannot be undone.")
        print("run it? [y/N] ", end="", file=sys.stderr, flush=True)
        try:
            answer = input()
        except EOFError:
            answer = ""
        confirmed = answer.strip().lower() in ("y", "yes")
        if not confirmed:
            _note("not run")
            return 0

    result = actions.execute(plan, confirmed=confirmed)
    print(result["output"])
    return 0 if result["ok"] else 1


def cmd_ask(args: argparse.Namespace) -> int:
    engine = _engine()
    reply = _ask_model(engine, " ".join(args.text), [], args.stream)
    code = _handle_reply(reply, interactive=sys.stdin.isatty())
    if args.stop:
        engine.stop()
    return code


def cmd_chat(args: argparse.Namespace) -> int:
    engine = _engine()
    history: list[dict] = []
    _note("chat: /quit ends, /stop stops the model server, /help lists the actions")
    while True:
        try:
            line = input("you> ")
        except EOFError:
            print()
            break
        line = line.strip()
        if not line:
            continue
        if line in ("/quit", "/exit", "/q"):
            break
        if line == "/stop":
            engine.stop()
            _note("model server stopped")
            continue
        if line == "/help":
            _print_actions()
            continue

        reply = _ask_model(engine, line, history, args.stream)
        history.append({"role": "user", "content": line})
        history.append({"role": "assistant", "content": reply})
        _handle_reply(reply, interactive=sys.stdin.isatty())

    if args.stop:
        engine.stop()
    return 0


# ---------------------------------------------------------------------------
# speaking and listening
# ---------------------------------------------------------------------------


def cmd_say(args: argparse.Namespace) -> int:
    if voice.speak(" ".join(args.text)):
        return 0
    return 1


def _record(seconds: int) -> bytes | None:
    """Record mono 16 kHz WAV, which is what whisper.cpp wants.

    arecord is preferred because its -d stops the recording on its own; the
    parecord fallback has no such option, so it is started and interrupted
    after the same number of seconds. Neither is needed for anything else the
    assistant does, so both being absent is a message, not an error.
    """
    handle = tempfile.NamedTemporaryFile(suffix=".wav", delete=False)
    path = Path(handle.name)
    handle.close()

    arecord = shutil.which("arecord")
    if arecord:
        _note(f"recording for {seconds}s (speak now)")
        argv = [arecord, "-q", "-f", "S16_LE", "-r", "16000", "-c", "1",
                "-d", str(seconds), str(path)]
        try:
            completed = subprocess.run(argv)
        except OSError as exc:
            _note(f"could not start arecord: {exc}")
            return None
        if completed.returncode != 0:
            _note("the microphone did not record anything (is one connected?)")
            path.unlink(missing_ok=True)
            return None
        data = path.read_bytes()
        path.unlink(missing_ok=True)
        return data

    parecord = shutil.which("parecord")
    if parecord:
        _note(f"recording for {seconds}s (speak now)")
        argv = [parecord, "--format=s16le", "--rate=16000", "--channels=1",
                "--file-format=wav", str(path)]
        try:
            process = subprocess.Popen(argv)
        except OSError as exc:
            _note(f"could not start parecord: {exc}")
            return None
        time.sleep(seconds)
        process.terminate()
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            process.kill()
        data = path.read_bytes()
        path.unlink(missing_ok=True)
        return data

    path.unlink(missing_ok=True)
    _note("no recorder is installed - install one with: astra install alsa-utils")
    return None


def cmd_listen(args: argparse.Namespace) -> int:
    data = _record(args.seconds)
    if not data:
        return 1
    text = voice.transcribe(data)
    if not text:
        return 1
    print(text)
    return 0


# ---------------------------------------------------------------------------
# the web interface, status, actions, stop
# ---------------------------------------------------------------------------


def cmd_serve(args: argparse.Namespace) -> int:
    """Hand the web interface over to astraos.ai.server.

    The module belongs to the same package tree but is written separately, so
    this command adapts to whichever entry point it has: main(), serve() or
    run(), called with the keyword arguments it actually accepts. Adapting
    here means a missing argument in that module is a one-line message rather
    than an import that breaks the rest of this command.
    """
    settings = config.load_settings()
    lan = bool(args.lan)
    settings["lan"] = lan
    host = "0.0.0.0" if lan else "127.0.0.1"
    if lan:
        _note("--lan makes the web interface reachable from the local network; "
              "it is off by default, and every phone must pair first")
    if args.pair and not lan:
        _note("--pair without --lan has no phone to pair; the code is printed anyway")

    try:
        from astraos.ai import server  # noqa: PLC0415 - see the module comment
    except ImportError as exc:
        _note(f"the web interface is not installed (astraos.ai.server): {exc}")
        return 1

    entry = None
    for name in ("main", "serve", "run"):
        candidate = getattr(server, name, None)
        if callable(candidate):
            entry = candidate
            break
    if entry is None:
        _note("astraos.ai.server has no main(), serve() or run() to start")
        return 1

    try:
        parameters = inspect.signature(entry).parameters
    except (TypeError, ValueError):
        parameters = {}

    argv = []
    if lan:
        argv.append("--lan")
    if getattr(args, "pair", False):
        argv.append("--pair")
    if args.port is not None:
        argv += ["--port", str(args.port)]

    if "argv" in parameters:
        # server.main() takes an argv list; calling it with none would make it
        # re-parse this command's own command line and choke on the word "serve".
        result = entry(argv)
        return int(result) if isinstance(result, int) else 0

    kwargs = {}
    for key, value in (
        ("settings", settings),
        ("host", host),
        ("port", args.port),
        ("lan", lan),
        ("pair", bool(getattr(args, "pair", False))),
        ("open_browser", False),
    ):
        if key in parameters and value is not None:
            kwargs[key] = value

    result = entry(**kwargs)
    return int(result) if isinstance(result, int) else 0


# ---------------------------------------------------------------------------
# pairing
# ---------------------------------------------------------------------------

DEFAULT_WEB_PORT = 8765


def _web_port(args: argparse.Namespace) -> int:
    return int(args.port) if getattr(args, "port", None) else DEFAULT_WEB_PORT


def _web_request(port: int, method: str, path: str,
                 payload: dict | None = None) -> tuple[int, dict]:
    """One request to the assistant page on this machine. Never raises."""
    import urllib.error  # noqa: PLC0415 - only the pairing commands need it
    import urllib.request  # noqa: PLC0415

    url = f"http://127.0.0.1:{port}{path}"
    data = None
    headers = {"Accept": "application/json"}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            body = response.read().decode("utf-8")
            return response.status, (json.loads(body) if body else {})
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            return exc.code, json.loads(body) if body else {}
        except ValueError:
            return exc.code, {}
    except OSError as exc:
        return 0, {"detail": str(exc)}


def cmd_pair(args: argparse.Namespace) -> int:
    """Show a code that pairs one phone, by asking the running page for one.

    The page must be running with --lan (so the phone can reach it). The code
    exists only in that process's memory and expires on its own; the code is
    shown here and in the page's own terminal, never anywhere on the network.
    """
    port = _web_port(args)
    status, payload = _web_request(port, "POST", "/api/pairing", {"arm": True})
    if status == 0:
        _note(f"the assistant page is not answering on 127.0.0.1:{port}; "
              f"start it first: astra-ai serve --lan")
        return 1
    if status != 200:
        _note("the assistant page refused to show a code: "
              f"{payload.get('detail', f'status {status}')}")
        return 1
    print(f"phone pairing code: {payload.get('code', '')}")
    minutes = max(1, int(payload.get("expires_in", 600)) // 60)
    print("valid for %d minutes; on the phone open this address and enter the code:"
          % minutes)
    for url in payload.get("urls") or [f"http://<this machine's address>:{port}/"]:
        print(f"  {url}")
    print("the code pairs one phone; a second phone means a new code "
          "(astra-ai pair again)")
    return 0


def cmd_unpair(args: argparse.Namespace) -> int:
    """Revoke every paired phone. The tokens live in the page's memory."""
    port = _web_port(args)
    status, payload = _web_request(port, "POST", "/api/unpair", {"all": True})
    if status == 0:
        _note(f"the assistant page is not answering on 127.0.0.1:{port}; "
              f"there is nothing paired to revoke")
        return 1
    if status != 200 or not payload.get("ok"):
        _note("the assistant page refused the request: "
              f"{payload.get('detail', f'status {status}')}")
        return 1
    count = int(payload.get("revoked", 0))
    if count == 0:
        print("no phone is paired; nothing to revoke")
    else:
        print(f"revoked {count} paired phone(s); they must pair again to reach the page")
    return 0


def cmd_profile(args: argparse.Namespace) -> int:
    """`astra-ai profile`: measure this machine and write it down.

    The profile is written beside the settings, under the same account that ran the
    command: an unprivileged reading of /proc and /sys, printed in plain words and
    kept as JSON so later features (engine-build selection, the readiness tier)
    read the same numbers instead of measuring the machine a second time.
    """
    profile = machine.collect()
    for line in machine.plain_words(profile):
        print(line)
    path = machine.write(profile, config.PATHS.profile_file)
    print()
    print(f"written to {path}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    info = ai_setup.describe()
    build = ai_setup.engine_build()
    health = llm.Engine(config.load_settings()).health()

    # The capability profile is written at first run; `status` is the command a new
    # user runs first, so it makes sure the profile exists (a read-only measurement,
    # never privileged) and names where it lives.
    profile_path = config.PATHS.profile_file
    if machine.load(profile_path) is None:
        try:
            machine.write(machine.collect(), profile_path)
        except OSError:
            pass

    print("AstraOS assistant")
    print(f"  model          {info['model'] or 'none installed'}")
    print(f"  llama-server   {info['llama_server'] or 'not installed'}")
    if build["variant"]:
        if build["missing"]:
            print(f"  engine build   {build['variant']}, and this CPU does not list "
                  f"{', '.join(build['missing'])}:")
            print("                 it would die with SIGILL on the first question - "
                  "rebuild: astra-ai setup --build all --variant avx")
        else:
            print(f"  engine build   {build['variant']} (this CPU lists its "
                  "requirements)")
    profile = machine.load(profile_path)
    if profile:
        recommendation = profile.get("recommendation") or machine.recommend(profile)
        rung = recommendation["rung"]
        variant = recommendation["engine_variant"] or "no build for this CPU"
        print(f"  ai rung        {rung} ({variant})")
    print(f"  speech         {info['tts_tool'] or 'not installed'}")
    print(f"  transcription  {'ready' if info['stt'] else 'not installed'}")
    print(f"  models kept in {info['models_dir']}")
    print(f"  settings       {info['config_file']}")
    print(f"  profile        {profile_path if profile_path.exists() else 'not written'}")
    if health["ok"]:
        print(f"  model server   answering on {health['host']}:{health['port']} "
              f"(pid {health['pid']})")
    else:
        print(f"  model server   {health['message']}")
    return 0


def _print_actions() -> None:
    print("everything the assistant can do (and nothing else):\n")
    for entry in actions.list_actions():
        if entry["needs_confirm"]:
            marker = " [asks the user first]"
        elif entry["dangerous"]:
            marker = " [destructive]"
        else:
            marker = ""
        print(f"  {entry['name']}({', '.join(entry['args'])}){marker}")
        print(f"      {entry['summary']}")


def cmd_actions(args: argparse.Namespace) -> int:
    if args.json:
        import json

        print(json.dumps(actions.list_actions(), indent=2, sort_keys=True))
        return 0
    _print_actions()
    return 0


def cmd_stop(args: argparse.Namespace) -> int:
    engine = _engine()
    health = engine.health()
    if not health["running"]:
        _note("no model server was started by this account; nothing to stop")
        return 0
    pid = health["pid"]
    engine.stop()
    _note(f"stopped the model server (pid {pid}) - the memory is free again")
    return 0


# ---------------------------------------------------------------------------
# The three-tier assistant: work, journal, skills, knowledge
# ---------------------------------------------------------------------------


def _terminal_confirm(action: str, call_args: dict) -> bool:
    """Ask the person at this terminal, with the exact action in front of them.

    Nothing dangerous runs on a terminal that cannot ask: the only way to say yes
    is to type it, and an end of input is a no.
    """
    question = ai_worker.question_for(action, call_args)
    print(f"astra-ai: {question}", file=sys.stderr)
    print("astra-ai: run it? [y/N] ", end="", file=sys.stderr, flush=True)
    try:
        answer = sys.stdin.readline().strip().lower()
    except (OSError, EOFError):
        answer = ""
    return answer in ("y", "yes")


def cmd_work(args: argparse.Namespace) -> int:
    """Answer a request with the executor and the middle brain.

    This is the command that is not the old one. `ask` is one model, one
    action, no plan; `work` is the ladder: the executor decides what the request
    is, escalates to the middle brain when it is more than one step, and then
    runs the plan one task at a time with every step verified and journalled.

    Confirmation is interactive, and it is asked with the exact command in front
    of the user. Nothing dangerous runs on a terminal that cannot ask, because
    the only way to say yes is to type it.
    """
    settings = config.load_settings()
    pool = tiers.TierPool(settings)
    agent = ai_worker.Worker(pool, confirm=_terminal_confirm)
    goal = " ".join(args.text).strip()
    outcome = agent.handle(goal)

    if args.json:
        print(json.dumps(outcome, indent=2, sort_keys=True))
        return 0

    for step in outcome.get("plan", []):
        print(f"astra-ai: step: {step.get('action')}({step.get('args', {})})",
              file=sys.stderr)
    for evidence in outcome.get("evidence", []):
        if evidence.get("output"):
            print(f"astra-ai:   -> {evidence['output']}")
    if outcome.get("text"):
        print(f"astra-ai: {outcome['text']}")
    else:
        print("astra-ai: nothing to report.", file=sys.stderr)
    return 0 if outcome.get("kind") in ("action", "answer") else 1


def cmd_resume(args: argparse.Namespace) -> int:
    """Continue a plan that stopped, from the journal rather than from memory.

    The journal stores the plan before the first step runs, so a crash, a reboot
    or a terminal closed at the wrong moment leaves a task that can be picked up
    again. With no id the command lists what is open; with one it starts at the
    first step that did not succeed, so a failed third step is retried rather than
    skipped over.

    Resuming needs no model of its own to start: the steps are already decided,
    and a step that needs new arguments asks for them exactly as it did the first
    time. Confirmation is the same terminal question as `astra-ai work`.
    """
    from astraos.ai import journal as journal_module

    journal = journal_module.journal()
    task_id = (args.task or "").strip()

    if not task_id:
        open_tasks = journal.unfinished()
        if not open_tasks:
            _note("no task is waiting to be resumed")
            return 0
        print("tasks that can be resumed:")
        for task in open_tasks:
            goal = " ".join(str(task.get("goal", "")).split())
            if len(goal) > 60:
                goal = goal[:57] + "..."
            print(
                f"  {task['id']}  {task['status']:<11}  step {task['step_index']}"
                f"  {goal}"
            )
        print("")
        print("continue one with:  astra-ai resume ID")
        return 0

    task = journal.task(task_id)
    if task is None:
        _note(f"there is no task called {task_id!r}")
        return 2

    settings = config.load_settings()
    pool = tiers.TierPool(settings)
    agent = ai_worker.Worker(pool, confirm=_terminal_confirm)
    outcome = agent.resume_task(task_id)

    if args.json:
        print(json.dumps(outcome, indent=2, sort_keys=True))
        return 0 if outcome.get("kind") in ("action", "answer") else 1

    for step in outcome.get("plan", []):
        print(f"astra-ai: step: {step.get('action')}({step.get('args', {})})",
              file=sys.stderr)
    for evidence in outcome.get("evidence", []):
        if evidence.get("output"):
            print(f"astra-ai:   -> {evidence['output']}")
    if outcome.get("text"):
        print(f"astra-ai: {outcome['text']}")
    return 0 if outcome.get("kind") in ("action", "answer") else 1


def cmd_journal(args: argparse.Namespace) -> int:
    """The task journal: what ran, what failed, and what a human must decide.

    The journal is the part of this assistant a person can read. It exists
    because the two largest measured failure modes of small-model agents are
    bookkeeping failures (repeating a step: 15.7%; not knowing they are
    finished: 12.4% - MAST, arXiv 2503.13657), and the fix for both is a
    written record with the budget in it.
    """
    from astraos.ai import journal as journal_module

    journal = journal_module.journal()
    if args.json:
        summary = journal.summary()
        summary["open"] = summary["open"]
        print(json.dumps(summary, indent=2, sort_keys=True))
        return 0

    summary = journal.summary()
    print(f"journal: {summary['path']}")
    print(f"plan.md: {summary['plan']}")
    for status, count in summary["tasks"].items():
        if count:
            print(f"  {status:12} {count}")
    waiting = summary["pending_approvals"]
    if waiting:
        print("  awaiting a human:")
        for approval in waiting:
            print(f"    #{approval['id']} {approval['action']}: {approval['question']}")
    if not any(summary["tasks"].values()):
        print("  (nothing has run yet)")
    return 0


def cmd_skills(args: argparse.Namespace) -> int:
    """The skills that are installed, and what is missing to run them."""
    from astraos.ai import skills as skills_module

    if args.json:
        print(json.dumps({
            "stats": skills_module.stats(),
            "skills": [
                {
                    "name": skill.name,
                    "title": skill.title,
                    "when": skill.when,
                    "keywords": skill.keywords,
                    "requires": skill.requires,
                    "missing": skill.missing(),
                    "steps": len(skill.steps),
                }
                for skill in skills_module.load_all()
            ],
        }, indent=2, sort_keys=True))
        return 0

    stats = skills_module.stats()
    print(f"skills: {stats['count']} installed, {stats['usable']} usable here")
    print(f"yours:   {stats['user_dir']}")
    print("A skill is one SKILL.md file in one of those directories. Write one and")
    print("it is usable on the next question.")
    print()
    for skill in skills_module.load_all():
        missing = skill.missing()
        flag = " (needs " + ", ".join(missing) + ")" if missing else ""
        print(f"  {skill.name}{flag}")
        if skill.when:
            print(f"      {skill.when}")
        print(f"      {len(skill.steps)} steps")
    if not skills_module.load_all():
        print("  (none installed)")
    return 0


def cmd_knowledge(args: argparse.Namespace) -> int:
    """Search the machine's own documentation, or show what it holds."""
    from astraos.ai import knowledge as knowledge_module

    if not args.query:
        stats = knowledge_module.stats()
        print(f"knowledge: {stats['entries']} entries "
              f"({stats['knowledge']} documents, {stats['skills']} skills)")
        print(f"index:    {stats['index']}")
        print(f"in:       {stats['share_dir']}")
        return 0

    passages = knowledge_module.search(" ".join(args.query))
    if not passages:
        print("astra-ai: the machine's own documentation does not cover that.")
        print("astra-ai: (nothing is guessed in the gap)")
        return 1
    for passage in passages:
        print(f"--- {passage['id']}")
        print(passage["title"])
        print(passage["body"].strip())
    return 0


def cmd_eval(args: argparse.Namespace) -> int:
    """Run the fixed evaluation tasks and write the report.

    The numbers are the product, so a task the model failed is a measurement
    and not an error: the exit status is 0 whenever a report was written, and
    1 only when there is no engine to measure with. The engine is started
    before the first task, so model loading does not land inside any task's
    measured time.
    """
    engine = _engine()
    engine.start()
    report = ai_eval.run(engine, limit=args.limit or None, progress=_note)
    path = ai_eval.save(report)
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(ai_eval.render(report), end="")
    if args.stop:
        engine.stop()
    _note(f"report written to {path}")
    return 0


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="astra-ai",
        description="The AstraOS assistant: a small local model wired to the "
                    "desktop's own tools.",
        epilog="The model is optional. `astra-ai status` and `astra-ai actions` "
               "work with nothing installed.",
    )
    parser.add_argument("--version", action="version",
                        version=f"astra-ai {config.VERSION} (AstraOS)")

    sub = parser.add_subparsers(dest="command", metavar="COMMAND")

    p = sub.add_parser("setup", help="show, download and build what the assistant needs")
    p.add_argument("--list", action="store_true", help="list the models that can be installed")
    p.add_argument("--model", metavar="NAME", help="download one model from the catalogue")
    p.add_argument("--build", metavar="WHAT", nargs="?", const="all",
                   help="build llama-server, whisper-cli or all, from source")
    p.add_argument("--variant", metavar="WHICH", default=None,
                   help="engine build to produce: avx (default; the reference "
                        "machine and the CI artifact), avx2 (Haswell and later), "
                        "or auto (the newest this CPU can run)")
    p.add_argument("--voice", action="store_true",
                   help="set up voice: build whisper.cpp for this CPU when it is "
                        "missing, and say what to install for speaking")
    p.set_defaults(handler=cmd_setup)

    p = sub.add_parser("ask", help="ask one question and print the answer")
    p.add_argument("text", nargs="+", help="the question")
    p.add_argument("--stream", action="store_true",
                   help="print the model's reply as it arrives (for debugging)")
    p.add_argument("--stop", action="store_true",
                   help="stop the model server when the answer is complete")
    p.set_defaults(handler=cmd_ask)

    p = sub.add_parser("chat", help="a conversation, one line at a time")
    p.add_argument("--stream", action="store_true", help="print replies as they arrive")
    p.add_argument("--stop", action="store_true", help="stop the server on exit")
    p.set_defaults(handler=cmd_chat)

    p = sub.add_parser("say", help="speak the given text")
    p.add_argument("text", nargs="+", help="what to say")
    p.set_defaults(handler=cmd_say)

    p = sub.add_parser("listen", help="record, transcribe and print what was said")
    p.add_argument("--seconds", type=int, default=5, help="how long to record (default 5)")
    p.set_defaults(handler=cmd_listen)

    p = sub.add_parser("serve", help="the web interface (astraos.ai.server)")
    p.add_argument("--port", type=int, default=None, help="port for the web interface")
    p.add_argument("--lan", action="store_true",
                   help="listen on the local network, not only on this machine; "
                        "every phone must pair first")
    p.add_argument("--pair", action="store_true",
                   help="show a phone pairing code as soon as it starts")
    p.set_defaults(handler=cmd_serve)

    p = sub.add_parser("pair", help="show a code that pairs a phone with the page")
    p.add_argument("--port", type=int, default=None,
                   help="the page's port (default 8765, the web interface's)")
    p.set_defaults(handler=cmd_pair)

    p = sub.add_parser("unpair", help="revoke every phone paired with the page")
    p.add_argument("--port", type=int, default=None,
                   help="the page's port (default 8765)")
    p.set_defaults(handler=cmd_unpair)

    p = sub.add_parser("status", help="what is installed and whether the model is running")
    p.set_defaults(handler=cmd_status)

    p = sub.add_parser("profile",
                       help="measure this machine and write the capability profile")
    p.set_defaults(handler=cmd_profile)

    p = sub.add_parser("actions", help="list everything the assistant can do")
    p.add_argument("--json", action="store_true", help="as JSON, for scripts")
    p.set_defaults(handler=cmd_actions)

    p = sub.add_parser("stop", help="stop the model server this account started")
    p.set_defaults(handler=cmd_stop)

    p = sub.add_parser("work", help="do a task with the executor and the middle brain")
    p.add_argument("text", nargs="+", help="what to do, in one line")
    p.add_argument("--json", action="store_true", help="the whole result as JSON, for scripts")
    p.set_defaults(handler=cmd_work)

    p = sub.add_parser("journal", help="what ran, what failed, what needs a human")
    p.add_argument("--json", action="store_true", help="the summary as JSON")
    p.set_defaults(handler=cmd_journal)

    p = sub.add_parser("resume", help="continue a stored task where it stopped")
    p.add_argument("task", nargs="?", default="",
                   help="the task id; omit it to list the tasks that can be resumed")
    p.add_argument("--json", action="store_true", help="the whole result as JSON, for scripts")
    p.set_defaults(handler=cmd_resume)

    p = sub.add_parser("skills", help="the installed skills, and what each one needs")
    p.add_argument("--json", action="store_true", help="as JSON, for scripts")
    p.set_defaults(handler=cmd_skills)

    p = sub.add_parser("knowledge", help="search this machine's own documentation")
    p.add_argument("query", nargs="*", help="what to look up; omit it for a summary")
    p.set_defaults(handler=cmd_knowledge)

    p = sub.add_parser("eval", help="run the fixed evaluation tasks and write the numbers")
    p.add_argument("--limit", type=int, default=0, metavar="N",
                   help="run only the first N tasks")
    p.add_argument("--stop", action="store_true",
                   help="stop the model server when the suite is done")
    p.add_argument("--json", action="store_true", help="print the report as JSON")
    p.set_defaults(handler=cmd_eval)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    handler = getattr(args, "handler", None)
    if handler is None:
        parser.print_help()
        return 2

    try:
        return int(handler(args) or 0)
    except KeyboardInterrupt:
        print(file=sys.stderr)
        _note("stopped")
        return 130
    except BrokenPipeError:
        return 0
    except (ai_setup.SetupError, llm.EngineUnavailable) as exc:
        _note(str(exc))
        return 1
    except OSError as exc:
        _note(str(exc))
        return 1
    except Exception as exc:  # noqa: BLE001 - the user gets a line, not a traceback
        _note(f"internal error: {exc.__class__.__name__}: {exc}")
        _note("please report it with the output of `astra-ai status`")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
