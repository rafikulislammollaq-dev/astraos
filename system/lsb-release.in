# /etc/lsb-release
#
# Rendered from system/lsb-release.in by scripts/configure-live-build.sh.
#
# DISTRIB_ID and DISTRIB_DESCRIPTION report AstraOS so that tools which read
# lsb_release show the correct distribution name.
#
# DISTRIB_CODENAME reports the *Debian base* codename on purpose. A number of
# third-party scripts and packaging tools use this field to decide which Debian
# repository layout to expect, and reporting "nova" there would make them choose the
# wrong paths. The AstraOS codename is exposed through /etc/astraos-release and
# /etc/os-release (VERSION_CODENAME) instead.
DISTRIB_ID=AstraOS
DISTRIB_RELEASE=@@VERSION@@
DISTRIB_CODENAME=trixie
DISTRIB_DESCRIPTION="AstraOS @@VERSION@@ @@STAGE@@ (based on Debian @@BASE_RELEASE_VERSION@@ @@BASE_SUITE@@)"
