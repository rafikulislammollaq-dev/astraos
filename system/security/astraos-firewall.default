# /etc/default/ufw
#
# AstraOS firewall defaults (plan §13.4).
#
# Design intent:
#   * Default inbound policy is DENY. Nothing listens by default: no sshd, no web
#     server, no remote administration daemon is installed.
#   * Default outbound policy is ALLOW. A desktop must be able to browse, update and
#     reach the network without the user editing firewall rules.
#   * The firewall is NOT enabled in the live session. Enabling it there can break the
#     user's network access during installation, and the live session is short-lived.
#     docs/SECURITY.md documents how to enable and inspect it after installation.
#
# This file is checked into the repository and installed into the image, so the shipped
# policy is reviewable in the same place as the code that applies it.

IPV6=yes
DEFAULT_INPUT_POLICY="DROP"
DEFAULT_OUTPUT_POLICY="ACCEPT"
DEFAULT_FORWARD_POLICY="DROP"
DEFAULT_APPLICATION_POLICY="SKIP"
MANAGE_BUILTINS=no
IPT_SYSCTL=/etc/ufw/sysctl.conf
IPT_MODULES="nf_conntrack_ftp nf_nat_ftp nf_conntrack_netbios_ns"
