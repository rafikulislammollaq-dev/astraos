# AstraOS dark GTK theme descriptor.
#
# Installed to /usr/share/themes/AstraOS-Dark by scripts/build-packages.sh
# (`cp -a desktop/themes/. <stage>/usr/share/themes/`), which is on the GTK search
# path, so any user (and the greeter) can select it by name.
#
# The directory ships two stylesheets, one per widget toolkit generation:
#
#   gtk-3.0/gtk.css   GTK 3.24 — XFCE panel applets, Thunar, Mousepad,
#                     xfce4-settings, lightdm-gtk-greeter, GTK2 apps via the
#                     GTK2/3 bridge. This is the theme in daily use.
#   gtk-4.0/gtk.css   GTK 4 — GTK4-only applications. Same design, GTK4 node
#                     names.
#
# Both files are self-contained: they do not @import Adwaita, so a missing or
# version-mismatched upstream resource bundle cannot produce a half-styled
# desktop. Colours come from config/branding.env only.

[Desktop Entry]
Type=X-GNOME-Metatheme
Name=AstraOS-Dark
Comment=AstraOS dark desktop theme: near-opaque violet surfaces, 1px hairlines, neon focus ring
Comment[en]=AstraOS dark desktop theme
Encoding=UTF-8

[X-GNOME-Metatheme]
# The GTK theme name this directory provides. GTK3 resolves
# gtk-3.0/gtk.css and GTK4 resolves gtk-4.0/gtk.css under it.
GtkTheme=AstraOS-Dark

# Fallback hint for tools that compose metathemes. Every widget is styled here,
# so this is not a dependency, but it names a theme guaranteed to be present on
# Debian if a component is ever removed from this directory: a theme name with no
# stylesheet renders as an unstyled, near-black desktop, which is the single most
# common failure mode for a hand-written theme.
Inherits=Adwaita

# AstraOS does not ship a Metacity/Marco theme. The desktop runs xfwm4, whose
# decoration theme is selected in the xfconf xfwm4 channel, not here; naming a
# Metacity theme that is not installed is how a session ends up with invisible
# titlebars (docs/DESIGN.md §7).
MetacityTheme=Adwaita

# Icon and cursor themes are real installed components, so they are named
# precisely rather than left to a guess.
IconTheme=AstraOS
CursorTheme=Adwaita

# Window controls on the right, ordered minimise / maximise / close.
ButtonLayout=menu:minimize,maximize,close

[X-AstraOS-ThemeFiles]
# Informational only; no toolkit reads these keys. They exist so a reviewer can
# see which stylesheets this metatheme activates without listing the directory.
gtk-3.0/gtk.css=GTK 3.24 widget theme (default session)
gtk-4.0/gtk.css=GTK 4 widget theme
xfwm4/themerc=xfwm4 decoration geometry descriptor (themerc only; the titlebar
  bitmaps are generated by branding/tools and installed by the packaging step)