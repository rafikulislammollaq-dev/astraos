<?xml version="1.0" encoding="UTF-8"?>
<!--
  AstraOS panel layout (xfce4-panel channel).

  Two panels, matching the reference desktop screenshots:

    Panel 1  top, 30px, full width   application menu, running windows, tray, clock
    Panel 2  bottom, 40px, centred   launcher dock with the workspace switcher

  DESIGN NOTES

  * Panel 1 uses a solid background rather than transparency. Panel transparency costs
    a compositing pass on every redraw and is one of the first things to feel slow on
    low-end hardware (plan §7.1). The AstraOS look comes from the wallpaper and the
    greeter instead.

  * Only plugins that ship with the packages in config/package-lists/30-desktop are
    referenced. A plugin that is not installed makes Xfce log an error and leaves an
    empty slot, so anything uncertain is left out rather than guessed at.

  * Plugin numbering is contiguous. Gaps cause Xfce to warn and can leave a blank
    panel slot.
-->
<channel name="xfce4-panel" version="1.0">

  <property name="config" type="empty">
    <property name="panels" type="empty">
      <property name="panel-1" type="empty">
        <property name="position" type="string" value="p=8;x=0;y=0"/>
        <property name="length" type="uint" value="100"/>
        <property name="position-locked" type="bool" value="true"/>
        <property name="size" type="uint" value="30"/>
        <property name="icon-size" type="uint" value="20"/>
        <property name="background-style" type="uint" value="0"/>
        <property name="background-alpha" type="uint" value="100"/>
        <property name="enter-opacity" type="uint" value="100"/>
        <property name="leave-opacity" type="uint" value="100"/>
        <property name="autohide-behavior" type="uint" value="0"/>
        <property name="mode" type="uint" value="0"/>
        <property name="disable-struts" type="bool" value="false"/>
        <property name="plugin-ids" type="array">
          <value type="int" value="1"/>
          <value type="int" value="2"/>
          <value type="int" value="3"/>
          <value type="int" value="4"/>
          <value type="int" value="5"/>
          <value type="int" value="6"/>
          <value type="int" value="7"/>
          <value type="int" value="8"/>
        </property>
      </property>

      <property name="panel-2" type="empty">
        <property name="position" type="string" value="p=10;x=0;y=0"/>
        <property name="length" type="uint" value="1"/>
        <property name="position-locked" type="bool" value="true"/>
        <property name="size" type="uint" value="40"/>
        <property name="icon-size" type="uint" value="28"/>
        <property name="background-style" type="uint" value="0"/>
        <property name="background-alpha" type="uint" value="100"/>
        <property name="autohide-behavior" type="uint" value="0"/>
        <property name="mode" type="uint" value="0"/>
        <property name="disable-struts" type="bool" value="false"/>
        <property name="plugin-ids" type="array">
          <value type="int" value="9"/>
          <value type="int" value="10"/>
          <value type="int" value="11"/>
        </property>
      </property>
    </property>

    <property name="plugins" type="empty">
      <property name="plugin-1" type="string" value="whiskermenu"/>
      <property name="plugin-2" type="string" value="launcher"/>
      <property name="plugin-3" type="string" value="tasklist"/>
      <property name="plugin-4" type="string" value="separator"/>
      <property name="plugin-5" type="string" value="systray"/>
      <property name="plugin-6" type="string" value="pulseaudio"/>
      <property name="plugin-7" type="string" value="power-manager-plugin"/>
      <property name="plugin-8" type="string" value="clock"/>
      <property name="plugin-9" type="string" value="launcher"/>
      <property name="plugin-10" type="string" value="pager"/>
      <property name="plugin-11" type="string" value="showdesktop"/>
    </property>
  </property>

  <!-- Panel 1: application menu -->
  <property name="plugin-1" type="empty">
    <property name="button-icon" type="string" value="astraos-logo"/>
    <property name="button-title" type="string" value="Astra"/>
    <property name="show-button-title" type="bool" value="true"/>
    <property name="show-button-icon" type="bool" value="true"/>
    <property name="menu-opacity" type="uint" value="100"/>
    <property name="category-icon-size" type="uint" value="20"/>
    <property name="launcher-icon-size" type="uint" value="28"/>
    <property name="view-mode" type="int" value="0"/>
    <property name="position-categories-alternate" type="bool" value="false"/>
    <property name="position-categories-horizontal" type="bool" value="true"/>
    <property name="favorites" type="array">
      <value type="string" value="thunar.desktop"/>
      <value type="string" value="xfce4-terminal.desktop"/>
      <value type="string" value="firefox-esr.desktop"/>
      <value type="string" value="mousepad.desktop"/>
      <value type="string" value="astraos-welcome.desktop"/>
    </property>
  </property>

  <!-- Panel 1: quick launchers -->
  <property name="plugin-2" type="empty">
    <property name="items" type="array">
      <value type="string" value="thunar.desktop"/>
      <value type="string" value="xfce4-terminal.desktop"/>
      <value type="string" value="firefox-esr.desktop"/>
    </property>
    <property name="show-labels" type="bool" value="false"/>
  </property>

  <!-- Panel 1: running windows -->
  <property name="plugin-3" type="empty">
    <property name="show-labels" type="bool" value="true"/>
    <property name="show-handle" type="bool" value="false"/>
    <property name="grouping" type="bool" value="true"/>
    <property name="grouping-always" type="bool" value="false"/>
    <property name="window-scrolling" type="bool" value="true"/>
    <property name="middle-click" type="int" value="0"/>
    <property name="sort-order" type="uint" value="4"/>
    <property name="show-wireframes" type="bool" value="false"/>
  </property>

  <!-- Panel 1: expandable gap between windows and the tray -->
  <property name="plugin-4" type="empty">
    <property name="expand" type="bool" value="true"/>
    <property name="style" type="uint" value="0"/>
  </property>

  <!-- Panel 1: notification tray. NetworkManager's nm-applet, the pulseaudio plugin
       and Bluetooth (blueman) all register here, so no separate indicator is needed. -->
  <property name="plugin-5" type="empty">
    <property name="square-icons" type="bool" value="true"/>
    <property name="size-max" type="uint" value="22"/>
    <property name="hidden-legacy" type="bool" value="false"/>
  </property>

  <!-- Panel 1: volume -->
  <property name="plugin-6" type="empty">
    <property name="enable-keyboard-shortcuts" type="bool" value="true"/>
    <property name="show-notifications" type="bool" value="true"/>
  </property>

  <!-- Panel 1: battery. Only renders on hardware with a battery, which is correct. -->
  <property name="plugin-7" type="empty">
    <property name="show-label" type="bool" value="false"/>
    <property name="show-percentage" type="bool" value="true"/>
    <property name="show-notifications" type="bool" value="false"/>
  </property>

  <!-- Panel 1: clock -->
  <property name="plugin-8" type="empty">
    <property name="digital-layout" type="uint" value="3"/>
    <property name="digital-time-format" type="string" value="%H:%M:%S"/>
    <property name="digital-date-format" type="string" value="%a %d %b %Y"/>
    <property name="digital-time-font" type="string" value="DejaVu Sans Mono Bold 12"/>
    <property name="digital-date-font" type="string" value="DejaVu Sans 9"/>
    <property name="tooltip-format" type="string" value="%A %d %B %Y"/>
    <property name="flash-separators" type="bool" value="false"/>
    <property name="show-seconds" type="bool" value="true"/>
  </property>

  <!-- Panel 2: dock launchers -->
  <property name="plugin-9" type="empty">
    <property name="items" type="array">
      <value type="string" value="thunar.desktop"/>
      <value type="string" value="xfce4-terminal.desktop"/>
      <value type="string" value="firefox-esr.desktop"/>
      <value type="string" value="mousepad.desktop"/>
      <value type="string" value="org.gnome.DiskUtility.desktop"/>
      <value type="string" value="gparted.desktop"/>
      <value type="string" value="synaptic.desktop"/>
      <value type="string" value="astraos-welcome.desktop"/>
    </property>
    <property name="show-labels" type="bool" value="false"/>
  </property>

  <!-- Panel 2: workspace switcher (the coloured workspace pills in the references) -->
  <property name="plugin-10" type="empty">
    <property name="style" type="uint" value="2"/>
    <property name="rows" type="uint" value="1"/>
    <property name="workspace-scrolling" type="bool" value="true"/>
    <property name="show-names" type="bool" value="false"/>
    <property name="num-rows" type="uint" value="1"/>
  </property>

  <!-- Panel 2: show desktop -->
  <property name="plugin-11" type="empty">
    <property name="show-image" type="bool" value="true"/>
  </property>
</channel>
