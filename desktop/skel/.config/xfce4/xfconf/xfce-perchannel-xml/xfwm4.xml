<?xml version="1.0" encoding="UTF-8"?>
<!--
  AstraOS window manager defaults (xfwm4 channel).

  NOTES ON DELIBERATE CHOICES

  * theme is "Default", not "AstraOS-Dark". AstraOS 0.1.0 ships a colour-only GTK
    theme and does not ship a full xfwm4 titlebar theme. Pointing xfwm4 at a theme
    name with no window-decoration assets installed produces missing titlebars, so the
    name is left at the upstream "Default" theme, which is guaranteed present with the
    xfwm4 package. Documented in docs/KNOWN_LIMITATIONS.md.

  * Compositing is enabled because it is needed for window shadows and for the panel's
    own transparency to work at all, but the expensive effects are off: no window
    zoom, no frame opacity, no blur. The desktop target is responsiveness on modest
    hardware (plan §7.1).
-->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Default"/>
    <property name="title_font" type="string" value="DejaVu Sans Bold 10"/>
    <property name="title_alignment" type="string" value="center"/>
    <property name="title_shadow_active" type="string" value="false"/>
    <property name="title_shadow_inactive" type="string" value="false"/>
    <property name="button_layout" type="string" value="O|SHMC"/>
    <property name="button_offset" type="int" value="0"/>
    <property name="button_spacing" type="int" value="4"/>
    <property name="full_width_title" type="bool" value="true"/>
    <property name="maximized_offset" type="int" value="0"/>
    <property name="snap_width" type="int" value="10"/>
    <property name="snap_height" type="int" value="10"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="snap_to_windows" type="bool" value="true"/>
    <property name="wrap_windows" type="bool" value="true"/>
    <property name="wrap_workspaces" type="bool" value="false"/>
  </property>

  <property name="cycle" type="empty">
    <property name="cycle_workspaces" type="bool" value="false"/>
    <property name="cycle_hidden" type="bool" value="true"/>
    <property name="cycle_minimum" type="bool" value="true"/>
    <property name="cycle_preview" type="bool" value="false"/>
    <property name="cycle_tabwin_mode" type="int" value="0"/>
  </property>

  <property name="compositor" type="empty">
    <property name="enable_compositing" type="bool" value="true"/>
    <property name="use_compositing" type="bool" value="true"/>
    <property name="shadow_delta_height" type="int" value="0"/>
    <property name="shadow_delta_width" type="int" value="0"/>
    <property name="shadow_delta_x" type="int" value="0"/>
    <property name="shadow_delta_y" type="int" value="-3"/>
    <property name="shadow_opacity" type="int" value="40"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
    <property name="show_popup_shadow" type="bool" value="true"/>
    <!-- Expensive effects deliberately disabled. -->
    <property name="show_dock_shadow" type="bool" value="false"/>
    <property name="vblank_mode" type="string" value="auto"/>
    <property name="sync_to_vblank" type="bool" value="true"/>
  </property>

  <property name="ui" type="empty">
    <property name="double_click_action" type="string" value="maximize"/>
    <property name="show_dock_shadow" type="bool" value="false"/>
  </property>
</channel>
