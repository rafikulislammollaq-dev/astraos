[Icon Theme]
Name=AstraOS
Comment=AstraOS icon theme: an overlay over Papirus, hicolor and Adwaita
Comment[en]=AstraOS icon theme: an overlay over Papirus, hicolor and Adwaita
# Everything AstraOS does not override falls through in order: Papirus (the
# full colour application set installed since 0.2.0 - see
# config/package-lists/30-desktop.list.chroot), then hicolor (the freedesktop
# fallback for anything Debian packages ships), then Adwaita (always in the
# image). All three are listed deliberately: the first gives every app a
# modern rounded icon, the second is the generic fallback, the third is the
# only set guaranteed by the base image - so an image missing one of them
# still resolves icons for most of the session rather than showing empty
# placeholders.
Inherits=Papirus,hicolor,Adwaita

# The generated cursor themes are installed into this icon theme's cursors/
# subdirectory (scripts/build-packages.sh -> /usr/share/icons/AstraOS/cursors), so the
# icon theme has to declare them. Without this key nothing looks the cursor theme up
# and X11 keeps drawing its built-in bitmap pointer for every one of the 45 names a
# client can request. desktop/skel/.../xsettings.xml also sets CursorThemeName; this
# key is what makes the lookup resolve for tools that read the icon theme instead.
Cursor Theme=AstraOS

# Directories that actually exist in this tree. Every entry listed here has a
# matching stanza below and a directory on disk. Declaring a directory that is
# not shipped produces a lookup miss on every query, so the list is kept equal
# to what branding/icons/ contains rather than to what it might contain later:
#
#   scalable/apps/   astraos-installer.svg
#                    astraos-logo.svg
#                    astraos-welcome.svg
#
# Adding a directory here without adding the files, or the files without this
# line, is the mistake this comment exists to prevent.
Directories=scalable/apps

[scalable/apps]
Size=256
Context=Applications
Type=Scalable
MinSize=8
MaxSize=512
# Rendered at whatever size the application asks for; the SVGs are resolution
# independent, which is why no separate size subdirectories are needed.

# Example stanza for a directory added later:
#
# [scalable/places]
# Size=256
# Context=Places
# Type=Scalable
# MinSize=8
# MaxSize=512
#
# Then add `,scalable/places` to the Directories line above.
#
# Directory contexts AstraOS does not use, and must not claim, because it ships
# no artwork for them: scalable/status, scalable/emblems, scalable/actions,
# scalable/categories, scalable/other. Icons for those contexts resolve through
# Inherits.