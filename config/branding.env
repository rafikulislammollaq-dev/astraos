# AstraOS branding definition.
#
# Two visual layers, deliberately separate:
#   BRAND layer   - neon ring, gradients, boot splash, login, installer.
#                   Seen briefly, so it can afford heavy effects.
#   DESKTOP layer - graphite/cyan, flat, cheap to render. Per plan §7.1 the
#                   desktop must avoid transparency and blur on low-end hardware.
#
# Palette derived from the reference screenshots in docs/reference/.

# ---- Names ----------------------------------------------------------------
BRAND_NAME="AstraOS"
BRAND_SHORT_NAME="Astra"
BRAND_WORDMARK="ASTRA OS"
BRAND_TAGLINE="Stellar Desktop Environment"
BRAND_VENDOR="AstraOS Project"

# ---- Brand layer palette (neon, from reference screenshots) ---------------
BRAND_VOID="#05030A"
BRAND_VOID_2="#0B0716"
BRAND_NEON_MAGENTA="#FF2FB9"
BRAND_NEON_PINK="#FF5CC8"
BRAND_NEON_PURPLE="#8B3DFF"
BRAND_NEON_CYAN="#22E6FF"
BRAND_GRADIENT_START="#FF5CC8"
BRAND_GRADIENT_MID="#8B3DFF"
BRAND_GRADIENT_END="#22E6FF"

# ---- Desktop layer palette (graphite + restrained cyan, plan §7.1) -------
COLOR_BG_DARK="#12141A"
COLOR_BG_MID="#1A1E26"
COLOR_BG_RAISED="#232833"
COLOR_HAIRLINE="#2E3542"
COLOR_TEXT_DARK_THEME="#E8ECF2"
# COLOR_TEXT_DIM is NOT set here. It is defined once, in the HUD/session token block
# below, which owns the text scale that DESIGN.md §2 locked. It used to be declared
# here as #98A2B3 as well; because scripts/lib/astraos_env.py returns the file verbatim
# and the last definition wins, that second declaration silently shadowed the first,
# so every consumer reading COLOR_TEXT_DIM got #9A93B8 while the Light GTK themes were
# still hand-written against the dead #98A2B3. tests/static/test_config.py now rejects
# a repeated key in this file so it cannot happen again. Declare a token once.
COLOR_ACCENT_PRIMARY="#22E6FF"
COLOR_ACCENT_SECONDARY="#3D8BFF"
COLOR_ACCENT_DANGER="#FF4D4D"
COLOR_ACCENT_WARN="#FFB020"
COLOR_ACCENT_OK="#2EE6C9"

COLOR_BG_LIGHT="#F4F6FA"
COLOR_BG_LIGHT_RAISED="#FFFFFF"
COLOR_TEXT_LIGHT_THEME="#1A1E26"
# COLOR_TEXT_DIM_LIGHT_THEME is the Light theme's inactive/dimmed text step. It cannot
# be COLOR_TEXT_FAINT (#6B6386): that is dimmed against the dark surface, and on the
# Light theme's #F4F6FA background it drops under the WCAG AA 4.5:1 threshold for body
# text. This is the same value darkened to hold roughly the contrast ratio COLOR_TEXT_FAINT
# has against the dark surface, so the two themes read at the same visual weight.
COLOR_TEXT_DIM_LIGHT_THEME="#5A5568"
COLOR_ACCENT_LIGHT="#0F6FB8"

# ---- HUD / session surface tokens -----------------------------------------
#
# docs/DESIGN.md §2 is the locked visual identity taken from the six reference
# screenshots. These tokens are the machine-readable form of that document, so the
# CSS, the window-decoration renderer, the cursor renderer and the HUD application
# all read one palette instead of three hand-copied ones.
#
# "Frosted glass" in those references is produced here with flat near-opaque surfaces
# plus a 1px hairline, never with a blur filter. GTK3 has no backdrop-filter, and
# plan §7.1 forbids effects that degrade low-end hardware, so the look is achieved
# with colour and border rather than with compositing cost.

# Values below carry no trailing inline comment on purpose: scripts/lib/astraos_env.py
# returns this file verbatim, and an inline comment would be read as part of the value
# by the asset renderer. Explain a token on the line above it.

# Surfaces.
# COLOR_VOID is the page / deepest background; COLOR_VOID_2 is a raised background.
COLOR_VOID="#05030A"
COLOR_VOID_2="#0B0716"
# COLOR_SURFACE is a near-opaque frosted panel fill; _SOLID is its opaque twin;
# _RAISED is a control drawn on top of a panel.
COLOR_SURFACE="#120C20"
COLOR_SURFACE_SOLID="#120C20"
COLOR_SURFACE_RAISED="#1C1430"

# Hairlines. Every border in the system is 1px and uses one of these two.
# _BASE is the neutral border, the flattened equivalent of rgba(255,255,255,0.08).
# _HOT is the focused / active border.
COLOR_HAIRLINE_BASE="#1F1830"
COLOR_HAIRLINE_HOT="#FF2FB9"

# Text, and its two dimmed steps flattened onto the panel surface.
COLOR_TEXT="#F2EEFF"
COLOR_TEXT_DIM="#9A93B8"
COLOR_TEXT_FAINT="#6B6386"

# HUD chrome accents (docs/DESIGN.md screen 6).
COLOR_HUD_TEAL="#2EE6C9"
COLOR_HUD_RED="#FF4D4D"

# Workspace pill accents (docs/DESIGN.md screen 4 bottom dock).
COLOR_WORKSPACE_AMBER="#FFD166"
COLOR_WORKSPACE_LIME="#B8F26D"
COLOR_WORKSPACE_CORAL="#FF8A5C"
COLOR_WORKSPACE_PLUM="#B36BFF"

# ---- Window decoration metrics (xfwm4) -------------------------------------
#
# The renderer reads these numbers and draws the decoration assets at exactly this
# geometry, so the generated images and the declared metrics cannot drift apart.
# A titlebar whose drawn height disagrees with what xfwm4 expects is what produces
# invisible or clipped titlebars, which is why they are generated rather than drawn
# by hand in a bitmap editor.
WINDOW_TITLEBAR_HEIGHT="30"
WINDOW_BORDER_WIDTH="1"
WINDOW_BUTTON_SIZE="18"
WINDOW_BUTTON_SPACING="4"
WINDOW_CORNER_RADIUS="10"
WINDOW_SHADOW_RADIUS="12"
WINDOW_TITLE_FONT="DejaVu Sans Bold 9"
WINDOW_TITLE_OFFSET="8"

# ---- Cursor theme ----------------------------------------------------------
# 16/24/32/48/64 is what a complete Xcursor theme actually needs. 128px was tried and
# dropped: X11 scales the 64px image up cleanly on HiDPI panels, and the extra size
# was four fifths of the committed blob for a size nothing requests.
CURSOR_SIZES="16 24 32 48 64"
# Pointer outline weight, as a fraction of the cursor's nominal size.
CURSOR_STROKE_RATIO="0.085"

# ---- HUD application -------------------------------------------------------
# The six labelled regions of docs/DESIGN.md screen 6, left to right, as GTK grid
# column weights. The weights sum to 10.
HUD_COLUMNS="1,1,4,1,1,2"
HUD_LABEL_HOT="#F2EEFF"
HUD_LABEL_COLD="#6B6386"
HUD_SAMPLE_INTERVAL_MS="1000"
HUD_TRAFFIC_SAMPLES="120"
HUD_METER_MAX_PERCENT="100"

# ---- Typography (licence-compatible, redistributable) ---------------------
# UI font: DejaVu Sans (Bitstream Vera licence) is present on every Debian system
# by default, so the desktop never falls back to an unbranded default.
BRAND_FONT_UI="DejaVu Sans"
BRAND_FONT_MONO="DejaVu Sans Mono"
BRAND_FONT_DISPLAY="DejaVu Sans"

# ---- Asset dimensions -----------------------------------------------------
BRAND_WALLPAPER_WIDTH="1920"
BRAND_WALLPAPER_HEIGHT="1080"
BRAND_SPLASH_WIDTH="1920"
BRAND_SPLASH_HEIGHT="1080"
BRAND_LOGO_SIZE="512"
BRAND_ICON_SIZES="16 22 24 32 48 64 128 256"

# ---- Third-party attribution (plan §23) -----------------------------------
BRAND_UPSTREAM_NOTICE="AstraOS is an independent distribution based on Debian GNU/Linux. AstraOS is not affiliated with or endorsed by the Debian Project."
