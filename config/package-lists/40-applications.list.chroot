# AstraOS default applications (plan §8).
#
# Every entry below is a maintained upstream program that is genuinely installable
# and launchable from the pinned Debian release. No fake launchers, no placeholder
# entries, no package included merely to make the menu look full.
#
# Category -> choice -> why:
#   Browser        firefox-esr        maintained by Debian/Mozilla, security-updated
#   File manager   thunar             XFCE-native, integrated with gvfs/udisks2
#   Terminal       xfce4-terminal     XFCE-native, in 30-desktop
#   Text editor    mousepad           lightweight, XFCE-native
#   PDF/document   atril              lightweight document viewer
#   Archives       xarchiver          XFCE-native archive front end
#   Media          parole, mpv        small players with hardware decode
#   Images         ristretto          XFCE-native image viewer
#   System admin   gnome-system-monitor, gparted, gnome-disk-utility
#   Software       synaptic           APT front end, no Flatpak/packagekit daemon
#   Media writing  xfburn             optional optical media support
#   Screenshots    xfce4-screenshooter (in 30-desktop)

firefox-esr

mousepad
vim-tiny
vim-gtk3

# Windows-bridge app equivalents: mspaint -> Drawing, calc -> galculator,
# and fastfetch for the terminal summary (astra info / first prompt).
galculator
drawing
fastfetch

atril
xarchiver
ristretto
parole
mpv
xfburn

synaptic
gnome-system-monitor
gparted
gnome-disk-utility
baobab

imagemagick
# Document reading: pdftotext, pdfinfo, pdftoppm. It is also what the assistant's
# pdf-office skill runs on, so removing this removes that capability.
poppler-utils
ghostscript
libreoffice-calc
libreoffice-writer

python3
python3-gi
# The GTK 3 typelib and the Cairo text bindings. astraos-hud imports
# gi.repository.Gtk, Pango and PangoCairo to draw every panel, and live-build
# installs with --no-install-recommends, so the package's own Recommends is not
# enough to put them in the image: without them the HUD fails to import.
gir1.2-gtk-3.0
python3-gi-cairo
# The embedded terminal in the HUD's MAIN SHELL region. Without it the region
# shows why it is unavailable; with it, it is a real shell.
gir1.2-vte-3.91
python3-apt
python3-dbus
python3-pycurl
python3-yaml
python3-requests

# The assistant's voice, on the machine and offline.
#
# espeak-ng is small, in Debian, and works with no model to download, which is why
# astraos-ai prefers it to a neural voice (docs/AI.md 4). It is named here instead of
# being left to the package's Recommends, because live-build installs with
# --no-install-recommends: an assistant that cannot say anything until the user works
# out which package to add is a worse first impression than a robotic voice.
espeak-ng

# The cage around the assistant's model server.
#
# bubblewrap mounts the whole root read-only and gives the server a private /tmp
# before llama-server loads a model. It is named here, not left to Recommends,
# because live-build installs with --no-install-recommends and the sandbox must
# exist in the image for `sandbox: auto` to mean anything. If the kernel forbids
# unprivileged user namespaces, astra-ai says so and runs the server unconfined
# rather than failing to answer; it never silently claims a sandbox it does not
# have.
bubblewrap
