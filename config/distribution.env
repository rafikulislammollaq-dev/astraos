# /etc-layout: AstraOS distribution definition.
# Sourced by scripts/*.sh. Keep this file POSIX-safe: KEY="value" only, no command execution.

# ---- Identity -------------------------------------------------------------
ASTRAOS_NAME="AstraOS"
ASTRAOS_PRETTY_NAME="AstraOS 0.2.0 Alpha"
ASTRAOS_VERSION="0.2.0"
ASTRAOS_CODENAME="Nova"
ASTRAOS_RELEASE_STAGE="Alpha"
ASTRAOS_HOMEPAGE="https://astraos.invalid"
ASTRAOS_SUPPORT_URL="https://astraos.invalid/support"
ASTRAOS_BUG_URL="https://astraos.invalid/issues"

# ---- Base distribution ----------------------------------------------------
# Pinned to one Debian major release per release branch (plan §5). Verified by
# scripts/validate-environment.sh against the live archive before any build.
ASTRAOS_BASE_DISTRIBUTION="Debian"
ASTRAOS_BASE_RELEASE_CODENAME="trixie"
ASTRAOS_BASE_RELEASE_VERSION="13"
ASTRAOS_BASE_SUITE="trixie"
ASTRAOS_ARCH="amd64"
ASTRAOS_ARCH_DEB="amd64"

# ---- Repositories (authenticated APT only, plan §13.3) --------------------
ASTRAOS_DEBIAN_MIRROR="http://deb.debian.org/debian"
ASTRAOS_DEBIAN_SECURITY_MIRROR="http://security.debian.org/debian-security"
ASTRAOS_DEBIAN_COMPONENTS="main contrib non-free non-free-firmware"
ASTRAOS_ARCHIVE_AREAS="main"
ASTRAOS_SECURITY_SUITE="trixie-security"
ASTRAOS_UPDATES_SUITE="trixie-updates"

# ---- Live image -----------------------------------------------------------
ASTRAOS_ISO_VOLUME_ID="ASTRAOS_0_2_0_AMD64"
ASTRAOS_ISO_LABEL="AstraOS 0.2.0 Alpha amd64"
ASTRAOS_ISO_PREFIX="astraos"
ASTRAOS_LIVE_USER="astra"
ASTRAOS_LIVE_HOSTNAME="astra-live"
ASTRAOS_DEFAULT_HOSTNAME="astraos"
ASTRAOS_LIVE_DESKTOP="xfce"

# ---- Desktop / session stack ---------------------------------------------
ASTRAOS_DESKTOP="xfce"
ASTRAOS_DISPLAY_MANAGER="lightdm"
ASTRAOS_DISPLAY_SERVER="x11"
ASTRAOS_INIT="systemd"
ASTRAOS_INSTALLER="calamares"
ASTRAOS_BOOTLOADER="grub"

# ---- Filesystem -----------------------------------------------------------
ASTRAOS_ROOT_FILESYSTEM="ext4"
ASTRAOS_DEFAULT_ESP_SIZE_MIB="512"
ASTRAOS_DEFAULT_SWAP_POLICY="swapfile"
ASTRAOS_ENCRYPTION_SUPPORTED="optional"

# ---- Build behaviour ------------------------------------------------------
ASTRAOS_BUILD_DIR="build/live-build"
ASTRAOS_DIST_DIR="dist"
ASTRAOS_LOG_DIR="logs"
ASTRAOS_PARALLEL_JOBS="auto"

# Safety: refuse to build when the repository itself sits on a partition that
# has less free space than this (MiB). Prevents half-written ISOs (plan §16.2).
ASTRAOS_MIN_FREE_SPACE_MIB="15000"
