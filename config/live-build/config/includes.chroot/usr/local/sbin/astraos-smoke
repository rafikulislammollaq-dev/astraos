#!/bin/sh
# AstraOS boot self-test - the guest half of scripts/smoke-boot.sh.
#
# WHAT THIS IS
#   A machine describing itself. The systemd unit starts it only when the kernel command
#   line contains "astraos.ci=1"; every line below goes to the serial console, and the
#   RESULT line tells scripts/smoke-boot.sh whether the image did what it claims.
#
#   In a normal boot the unit's condition keeps this script from running at all. Nothing
#   here writes outside /tmp and the journal, and the only privileged act is the final
#   power-off, which is the caller's signal that the guest is finished.
#
# OUTPUT CONTRACT (grepped by scripts/smoke-boot.sh; keep the markers stable):
#   ASTRAOS-SMOKE: ok <name> (<detail>)
#   ASTRAOS-SMOKE: FAIL <name> (<detail>)
#   ASTRAOS-SMOKE: note <text>
#   ASTRAOS-SMOKE: RESULT: PASS|FAIL (<n> checks, <f> failed)
#   ASTRAOS-SMOKE: end

export LC_ALL=C

FAILED=0
CHECKS=0

say() { printf 'ASTRAOS-SMOKE: %s\n' "$*"; }
ok() { CHECKS=$((CHECKS + 1)); say "ok $1 ($2)"; }
bad() { CHECKS=$((CHECKS + 1)); FAILED=$((FAILED + 1)); say "FAIL $1 ($2)"; }

# has_pkg PKG - the package is installed and configured in this image.
has_pkg() {
    status=$(dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null || true)
    case "$status" in
        "ii ")
            ok "pkg-$1" "$(dpkg-query -W -f='${Version}' "$1" 2>/dev/null)"
            ;;
        *)
            bad "pkg-$1" "status: ${status:-not installed}"
            ;;
    esac
}

# run NAME COMMAND... - the command must exit 0; its first output line is quoted.
run() {
    name=$1
    shift
    out=$("$@" 2>&1)
    rc=$?
    first=$(printf '%s\n' "$out" | head -n 1)
    if [ "$rc" -eq 0 ]; then
        ok "$name" "$first"
    else
        bad "$name" "exit $rc: $first"
    fi
}

# The live account name comes from the kernel command line, where live-config put it;
# the fallback only matters if a kernel command line drops it entirely.
LIVE_USER=$(sed -n 's/.*username=\([^ ]*\).*/\1/p' /proc/cmdline | head -n 1)
LIVE_USER=${LIVE_USER:-astra}

if [ -r /etc/os-release ]; then
    . /etc/os-release
fi

say "begin"

# Two systems boot with this script: the live medium (astraos.ci=1; the boot
# self-test) and the installed system the install exercise produced
# (astraos.ci.installed=1). They differ in what the boot ends in - a live session
# versus a login greeter - and every difference below hangs off this switch.
MODE=live
if grep -q 'astraos.ci.installed' /proc/cmdline; then
    MODE=installed
fi
say "mode: $MODE"

say "os: ${PRETTY_NAME:-unknown}"
say "kernel: $(uname -r), architecture $(uname -m)"
say "cpu: $(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -n 1)"
say "memory: $(awk '/MemTotal/ { printf "%.0f MiB", $2 / 1024 }' /proc/meminfo)"

# --- 1. the identity ----------------------------------------------------------------
case "${PRETTY_NAME:-}" in
    AstraOS*)
        ok "identity" "$PRETTY_NAME"
        ;;
    *)
        bad "identity" "/etc/os-release says: ${PRETTY_NAME:-unknown}"
        ;;
esac

# --- 2. the display and the session -------------------------------------------------
# The live medium logs the throwaway account in automatically (live-config arranges it),
# so a successful live boot ends in a running Xfce session. The installed system does
# the opposite on purpose: no autologin, so the boot ends at the LightDM greeter - and
# the install exercise's lockdown step exists to guarantee exactly that. On an emulated
# CPU the session keeps loading after the unit starts, so wait for the real landmark:
# the window manager on the live boot, the greeter process on the installed one.
waited=0
while [ "$waited" -lt 300 ]; do
    if [ -S /tmp/.X11-unix/X0 ]; then
        if [ "$MODE" = installed ]; then
            pgrep -f 'lightdm.*greeter' >/dev/null 2>&1 && break
        else
            pgrep -u "$LIVE_USER" xfwm4 >/dev/null 2>&1 && break
        fi
    fi
    sleep 2
    waited=$((waited + 1))
done

if [ -S /tmp/.X11-unix/X0 ]; then
    ok "x-display" "/tmp/.X11-unix/X0 after $((waited * 2))s"
else
    bad "x-display" "no X socket after $((waited * 2))s"
fi

run "lightdm" systemctl is-active lightdm

if [ "$MODE" = installed ]; then
    if pgrep -f 'lightdm.*greeter' >/dev/null 2>&1; then
        ok "installed-greeter" "the installed system shows a login greeter, not a session"
    else
        bad "installed-greeter" "no greeter process is running"
    fi
else
    if pgrep -u "$LIVE_USER" xfwm4 >/dev/null 2>&1; then
        ok "session" "xfwm4 running as $LIVE_USER"
    else
        bad "session" "xfwm4 is not running as $LIVE_USER"
    fi
fi

# --- 2b. the installed system's promises (installed boot only) ------------------------
# These are the installer's own lockdown claims, re-checked from outside the installer:
# what its shellprocess step wrote into the target must be true on the target itself.
if [ "$MODE" = installed ]; then
    if [ -s /etc/lightdm/lightdm.conf.d/90-astraos-installed.conf ]; then
        ok "installed-policy-file" "/etc/lightdm/lightdm.conf.d/90-astraos-installed.conf"
    else
        bad "installed-policy-file" "the installer's autologin policy file is missing or empty"
    fi

    autologin=$(grep -rsE '^[[:space:]]*autologin-user=[^[:space:]]+' /etc/lightdm/ 2>/dev/null | head -n 1)
    if [ -z "$autologin" ]; then
        ok "installed-no-autologin" "no autologin is configured under /etc/lightdm"
    else
        bad "installed-no-autologin" "an autologin survived: $autologin"
    fi

    if getent passwd "$LIVE_USER" >/dev/null 2>&1; then
        bad "installed-no-live-user" "the live account $LIVE_USER exists on the installed system"
    else
        ok "installed-no-live-user" "the live account $LIVE_USER is gone"
    fi

    good=0
    detail=""
    for name in $(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 { print $1 }'); do
        home=$(getent passwd "$name" | awk -F: '{ print $6 }')
        if [ -d "$home" ] && id -nG "$name" 2>/dev/null | grep -qw sudo; then
            good=$((good + 1))
            detail="${detail}${name} "
        fi
    done
    if [ "$good" -ge 1 ]; then
        ok "installed-user" "administrator account(s): ${detail}"
    else
        bad "installed-user" "no account with uid >= 1000, a home directory and sudo membership"
    fi
fi

# --- 3. every AstraOS package is installed ------------------------------------------
for pkg in astraos-base astraos-branding astraos-desktop astraos-hud astraos-ai \
           astraos-winbridge astraos-system-tools astraos-installer; do
    has_pkg "$pkg"
done

# --- 4. the hardware and compatibility stack ----------------------------------------
for pkg in intel-microcode amd64-microcode fwupd zram-tools vainfo \
           libavcodec-extra ffmpeg flatpak wine ntfs-3g exfatprogs \
           cups bluez network-manager pipewire; do
    has_pkg "$pkg"
done

# --- 4b. the virtual-machine guest agents --------------------------------------------
# AstraOS is most often tried in a virtual machine, so the image ships the agents the
# hypervisors expect (35-hardware.list.chroot). Where the caller provided the serial
# port a hypervisor would provide, the agent must actually be running: the package's
# udev rule starts qemu-guest-agent.service when the virtio port appears, so an active
# unit proves the port, the rule and the binary together. scripts/smoke-boot.sh always
# provides the port; a boot without it (the install exercise's disk boot, a hand boot
# of the raw kernel) says so instead of quietly passing.
for pkg in qemu-guest-agent spice-vdagent open-vm-tools open-vm-tools-desktop; do
    has_pkg "$pkg"
done
if [ -e /dev/virtio-ports/org.qemu.guest_agent.0 ]; then
    run "qemu-guest-agent" systemctl is-active qemu-guest-agent
else
    say "note qemu-guest-agent: no virtio guest-agent port on this boot; the agent ships but was not exercised"
fi

# --- 5. commands that must run -------------------------------------------------------
run "hud-version" astraos-hud --version
run "assistant-cli" astra-ai --help
run "all-in-one" astra help
run "winbridge-ver" /usr/lib/astraos/winbin/ver
run "wine" wine --version
run "ffmpeg" ffmpeg -version
run "flatpak" flatpak --version

# astra-ai status is informational: the shipped image has no model (the user chooses one,
# docs/AI.md), so a non-zero exit here is not an image defect.
status_out=$(astra-ai status 2>&1)
status_rc=$?
if [ "$status_rc" -eq 0 ]; then
    ok "assistant-status" "$(printf '%s\n' "$status_out" | head -n 1)"
else
    say "note assistant-status exit $status_rc: $(printf '%s\n' "$status_out" | head -n 1)"
fi

# --- 6. the application store --------------------------------------------------------
remotes=$(flatpak remotes --system 2>&1 || true)
case "$remotes" in
    *flathub*)
        ok "flathub-remote" "$(printf '%s\n' "$remotes" | head -n 1)"
        ;;
    *)
        bad "flathub-remote" "flatpak remotes --system: ${remotes:-empty}"
        ;;
esac

# --- 7. networking --------------------------------------------------------------------
run "networkmanager" systemctl is-active NetworkManager

ip4=$(ip -4 -o addr show scope global 2>/dev/null | awk '{ print $4 }' | head -n 1)
if [ -n "$ip4" ]; then
    ok "ipv4" "$ip4"
else
    bad "ipv4" "no global IPv4 address"
fi

# The defect this guards against (50-networking.list.chroot) is silent: the interface is
# up and every name lookup fails. Resolving a real name is the only honest check.
run "dns" getent hosts deb.debian.org

# --- 8. the firewall ------------------------------------------------------------------
# On by default since 2026-10-16 (docs/ROADMAP.md, docs/SECURITY.md §3): inbound is
# denied, and exactly two things are reachable from the local network - the assistant's
# page and mDNS (what finds printers). The behavioural half of the proof is inside the
# phone section: a port no rule allows is watched there while the caller of this script
# deliberately probes it from outside.
#
# The rule check reads `ufw status verbose`, not plain `ufw status`: the direction ("IN")
# is part of the Action column only in verbose mode (the shipped ufw 0.36.2 blanks it
# otherwise). The check's first CI run (38903678646) failed on exactly that spelling
# while the rule was provably enforced - a check must read what the tool prints, not
# what one remembers.
ufw_status=$(ufw status verbose 2>/dev/null || true)
case "$ufw_status" in
    "Status: active"*)
        ok "firewall-active" "ufw reports active"
        ;;
    *)
        bad "firewall-active" "ufw status: $(printf '%s' "$ufw_status" | head -n 1)"
        ;;
esac

if printf '%s\n' "$ufw_status" | grep -q '^Default: deny (incoming)'; then
    ok "firewall-default-deny" "incoming is denied unless a rule allows it"
else
    bad "firewall-default-deny" "the default incoming policy is not deny"
fi

if printf '%s\n' "$ufw_status" | grep -qE '^8765/tcp[[:space:]]+ALLOW IN[[:space:]]+192\.168\.0\.0/16'; then
    ok "firewall-page-allowed" "the assistant's port is reachable from local networks"
else
    rows=$(printf '%s\n' "$ufw_status" | grep -E '^8765/tcp|^5353/' | tr '\n' ';')
    bad "firewall-page-allowed" "8765/tcp from 192.168.0.0/16 is not in ufw status (rows ufw showed: ${rows:-none})"
fi

# --- 9. the phone page (only when the caller asked: astraos.phone=1) -----------------
# The mesh's first slice: the computer serves the assistant page on the local network,
# a phone pairs with a code shown on the computer, and revoking ends its access. The
# "phone" here is the CI host itself, reaching the guest through QEMU's port forward;
# it answers the "phone-code:" marker this section prints. The section runs only when
# scripts/smoke-boot.sh asked for it with astraos.phone=1, so a hand boot with
# astraos.ci=1 alone is unchanged.
if grep -q 'astraos.phone' /proc/cmdline; then
    phone_log=/tmp/astraos-phone.log
    python3 /usr/lib/astraos/ai/server.py --lan --pair --port 8765 >"$phone_log" 2>&1 &
    phone_pid=$!

    # The firewall's blocked-port half, part 1: watch a port that no rule allows. The
    # caller of this script probes it from the outside while the arc below runs; with
    # the firewall on the probe dies here and nothing arrives, with the firewall off
    # the arrival is recorded and check 7 fails. The listener records arrivals.
    : > /tmp/astraos-probe-hits
    rm -f /tmp/astraos-probe-ready
    python3 - <<'PY' >/dev/null 2>&1 &
import socket
sock = socket.socket()
sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
sock.bind(("0.0.0.0", 8766))
sock.listen(16)
with open("/tmp/astraos-probe-ready", "w") as handle:
    handle.write("listening\n")
while True:
    conn, _ = sock.accept()
    with open("/tmp/astraos-probe-hits", "a") as handle:
        handle.write("hit\n")
    conn.close()
PY
    probe_pid=$!
    waited=0
    while [ "$waited" -lt 15 ]; do
        [ -f /tmp/astraos-probe-ready ] && break
        sleep 1
        waited=$((waited + 1))
    done
    if [ -f /tmp/astraos-probe-ready ]; then
        ok "firewall-probe-listening" "port 8766 is watched for the blocked-port proof"
    else
        bad "firewall-probe-listening" "the probe listener did not come up"
    fi

    # 1. the code appears (the host needs it to pair)
    waited=0
    while [ "$waited" -lt 60 ]; do
        grep -q 'pair: code=' "$phone_log" 2>/dev/null && break
        sleep 2
        waited=$((waited + 1))
    done
    phone_code=$(sed -n 's/.*pair: code=\([0-9][0-9]*\).*/\1/p' "$phone_log" 2>/dev/null | head -n 1)
    if [ -n "$phone_code" ]; then
        ok "phone-armed" "pairing code shown after $((waited * 2))s"
        say "phone-code: $phone_code"
    else
        bad "phone-armed" "no pairing code after $((waited * 2))s"
    fi

    # 2. the computer itself needs no pairing: loopback is the owner's road in
    if python3 - <<'PY'
import json
import urllib.request
with urllib.request.urlopen("http://127.0.0.1:8765/api/health", timeout=15) as answer:
    assert answer.status == 200, answer.status
    assert "ready" in json.loads(answer.read().decode("utf-8"))
PY
    then
        ok "phone-localhost" "the page answers on this machine without pairing"
    else
        bad "phone-localhost" "the page did not answer on 127.0.0.1"
    fi

    # 3. the phone pairs (the host does it the moment it reads phone-code above)
    waited=0
    while [ "$waited" -lt 240 ]; do
        grep -q 'pair: paired from=' "$phone_log" 2>/dev/null && break
        sleep 2
        waited=$((waited + 1))
    done
    if grep -q 'pair: paired from=' "$phone_log" 2>/dev/null; then
        ok "phone-paired" "a phone paired with the code"
    else
        bad "phone-paired" "no phone paired within 240s"
    fi

    # 4. a paired request was served - the gate is a door, not a wall
    waited=0
    while [ "$waited" -lt 120 ]; do
        grep -q 'pair: authorized from=' "$phone_log" 2>/dev/null && break
        sleep 2
        waited=$((waited + 1))
    done
    if grep -q 'pair: authorized from=' "$phone_log" 2>/dev/null; then
        ok "phone-served" "a paired request was served"
    else
        bad "phone-served" "no paired request was served within 120s"
    fi

    # 5. revocation is the desktop user's own act, over loopback
    refusals_before=$(grep -c 'pair: refused token from=' "$phone_log" 2>/dev/null || true)
    refusals_before=${refusals_before:-0}
    if python3 - <<'PY'
import json
import urllib.request
request = urllib.request.Request(
    "http://127.0.0.1:8765/api/unpair", method="POST",
    data=json.dumps({"all": True}).encode("utf-8"),
    headers={"Content-Type": "application/json"})
with urllib.request.urlopen(request, timeout=15) as answer:
    payload = json.loads(answer.read().decode("utf-8"))
    assert answer.status == 200 and payload.get("ok"), payload
    assert payload.get("revoked", 0) >= 1, payload
PY
    then
        ok "phone-revoked" "every paired phone was revoked from this machine"
    else
        bad "phone-revoked" "the unpair request failed"
    fi

    # 6. the revoked phone keeps asking; its refusal is the last event to observe
    refusals=$refusals_before
    waited=0
    while [ "$waited" -lt 120 ]; do
        refusals=$(grep -c 'pair: refused token from=' "$phone_log" 2>/dev/null || true)
        refusals=${refusals:-0}
        [ "$refusals" -gt "$refusals_before" ] && break
        sleep 2
        waited=$((waited + 1))
    done
    if [ "$refusals" -gt "$refusals_before" ]; then
        ok "phone-refused-after-revoke" "the revoked phone was refused"
    else
        bad "phone-refused-after-revoke" "no refusal after revoking within 120s"
    fi

    # 7. the blocked-port proof, part 2: the caller probed 8766 while the arc above ran
    # (its attempt is recorded in phone-host.log). Any arrival here would mean the
    # firewall let through a connection that no rule allows.
    hits=$(wc -l < /tmp/astraos-probe-hits 2>/dev/null) || hits=0
    [ -n "$hits" ] || hits=0
    if [ "$hits" -eq 0 ]; then
        ok "firewall-blocks-other-ports" "no connection reached the watched port"
    else
        bad "firewall-blocks-other-ports" "$hits connection(s) reached port 8766"
    fi
    kill "$probe_pid" 2>/dev/null || true

    kill "$phone_pid" 2>/dev/null || true
fi

# --- the screen, ready for the caller's screenshot ------------------------------------
# The caller takes its picture of this desktop during the hold below, and that picture
# is evidence (the roadmap's HUD item rests on it). A QEMU stdvga defect - fixed upstream
# in 9.0.2, not in the 8.2 the CI runner ships - clears the shared framebuffer when the
# guest blanks the screen, and unblanking then stays black: run 38881934636's captured
# image was exactly that, a black screen with only the cursor, while this self-test
# reported a healthy session. So blanking is turned off for the rest of this boot, the
# display is forced back on if something had turned it off, and the whole screen is
# repainted (xrefresh) so the framebuffer holds the desktop again even if the defect
# had already run. x11-xserver-utils and x11-utils ship in the image (25-graphics list).
XAUTHORITY="/home/${LIVE_USER}/.Xauthority"
as_user() {
    runuser -u "$LIVE_USER" -- env DISPLAY=:0 XAUTHORITY="$XAUTHORITY" "$@"
}
if [ "$MODE" = installed ]; then
    # No user session to borrow: the greeter owns the display, and the X authority
    # meant to be readable on the installed system is lightdm's own.
    XAUTHORITY=/var/run/lightdm/root/:0
    as_user() {
        env DISPLAY=:0 XAUTHORITY="$XAUTHORITY" "$@"
    }
fi

# --- the dashboard, on screen (live medium only) --------------------------------------
# The roadmap's HUD item wants a capture that carries the HUD itself, and the HUD is a
# full-screen application started from its launcher - not an autostart - so this starts
# it the way a person would: as the live user, from the shipped entry point. A failure
# is a check, not a silent absence; the log tail goes to the serial console.
if [ "$MODE" = live ]; then
    as_user astraos-hud >/tmp/astraos-hud.log 2>&1 &
    waited=0
    while [ "$waited" -lt 20 ]; do
        pgrep -u "$LIVE_USER" -f 'astraos[-_]hud' >/dev/null 2>&1 && break
        sleep 1
        waited=$((waited + 1))
    done
    if pgrep -u "$LIVE_USER" -f 'astraos[-_]hud' >/dev/null 2>&1; then
        # give GTK its first frames; the capture follows within seconds
        sleep 5
        ok "hud-on-screen" "the dashboard is up as $LIVE_USER"
    else
        bad "hud-on-screen" "astraos-hud did not start: $(tail -n 2 /tmp/astraos-hud.log 2>/dev/null | tr '\n' ' ')"
    fi
fi

# --- the machine's capability profile, measured as the user (live medium only) --------
# Stage 2's first item: the assistant measures the machine (CPU flags and instruction
# sets, memory, graphics, an accelerator, audio, free space) and writes it in plain
# words beside its settings. Running it as the live user is the point: the profile is
# an unprivileged reading of /proc and /sys, never a privileged probe. The command
# prints the file it wrote; that file must exist and have content.
if [ "$MODE" = live ]; then
    if runuser -u "$LIVE_USER" -- astra-ai profile >/tmp/astra-ai-profile.log 2>&1; then
        profile_file="$(sed -n 's/^written to //p' /tmp/astra-ai-profile.log | head -n 1)"
        if [ -n "$profile_file" ] && [ -s "$profile_file" ]; then
            ok "ai-profile" "measured as $LIVE_USER and written to $profile_file"
        else
            bad "ai-profile" "no written profile: $(tail -n 2 /tmp/astra-ai-profile.log | tr '\n' ' ')"
        fi
    else
        bad "ai-profile" "astra-ai profile failed: $(tail -n 2 /tmp/astra-ai-profile.log | tr '\n' ' ')"
    fi
fi

# --- the offline help centre, in the image (live medium only) -------------------------
# The help centre is a feature of the image, not of the repository: the page has to be
# installed where the launcher opens it, and it has to carry the topics. A build that
# shipped the repository's copy but not the package's would give a user a "Help" entry
# that opens nothing, which is worse than no entry at all.
if [ "$MODE" = live ]; then
    help_page=/usr/share/astraos/ai/web/help.html
    help_entry=/usr/share/applications/astraos-helpcentre.desktop
    if [ -s "$help_page" ] && [ -f "$help_entry" ] \
        && grep -q 'id="search"' "$help_page" \
        && grep -q '<article id=' "$help_page"; then
        ok "help-centre" "the offline help centre is installed with $(grep -c '<article id=' "$help_page") topic(s)"
    else
        bad "help-centre" "the help centre is missing, empty or has no topics at ${help_page}"
    fi
fi

# --- the assistant the image ships ----------------------------------------------------
# The model and engine are in the medium, not downloaded on first use. This checks the
# files; ai-engine below actually executes the selected build on this CPU, and ai-guard
# records two decisions in a temporary ledger and walks the chain back.
if [ -s /usr/share/astraos/ai/models/Spark-X2.5-1.7B-Q4_K_M.gguf ] \
    && [ -s /usr/share/astraos/ai/models/ggml-tiny.en.bin ] \
    && [ -x /usr/lib/astraos/ai/engine/avx/llama-server ] \
    && [ -x /usr/lib/astraos/ai/engine/avx2/llama-server ]; then
    ok "ai-bundle" "executor, speech model and both engine variants are in the image"
else
    bad "ai-bundle" "a model or an engine variant is missing from the image"
fi

if grep -qw avx /proc/cpuinfo 2>/dev/null; then
    if llama-server --version >/tmp/astra-llama-version.log 2>&1; then
        ok "ai-engine" "$(head -n 1 /tmp/astra-llama-version.log)"
    else
        bad "ai-engine" "llama-server did not run: $(tail -n 2 /tmp/astra-llama-version.log | tr '\n' ' ')"
    fi
else
    say "note ai-engine (this CPU lists no AVX; the avx build is present but cannot run here)"
fi

if astra-guard levels >/tmp/astra-guard-levels.log 2>&1 \
    && grep -q 'privileged' /tmp/astra-guard-levels.log; then
    ok "ai-guard" "observe, prepare, modify and privileged are in the policy"
else
    bad "ai-guard" "astra-guard levels did not print the four levels"
fi

if ASTRAOS_GUARD_AUDIT=/tmp/astra-guard-smoke.jsonl python3 -c '
import sys
sys.path.insert(0, "/usr/lib")
from astraos.ai import guard
guard.record({"action": "tell_time", "level": "observe", "decision": "allowed", "provenance": "self-test"}, outcome="allowed")
guard.record({"action": "run_command", "level": "privileged", "decision": "refused", "provenance": "self-test"}, outcome="refused")
result = guard.verify()
print("records", result["count"], "ok", result["ok"])
raise SystemExit(0 if result["ok"] else 1)
' >/tmp/astra-guard-smoke.log 2>&1; then
    ok "ai-guard-chain" "two decisions recorded and the audit chain verified"
else
    bad "ai-guard-chain" "$(tail -n 2 /tmp/astra-guard-smoke.log | tr '\n' ' ')"
fi
rm -f /tmp/astra-guard-smoke.jsonl

if [ "$MODE" = live ]; then
    rm -rf /tmp/astra-files-smoke
    mkdir -p /tmp/astra-files-smoke/Documents
    printf 'hello from the image\n' > /tmp/astra-files-smoke/Documents/hello.txt
    chmod -R a+rX /tmp/astra-files-smoke
    if runuser -u "$LIVE_USER" -- env ASTRAOS_FILES_HOME=/tmp/astra-files-smoke \
        python3 -c 'import sys; sys.path.insert(0, "/usr/lib"); from astraos.ai import actions; print(actions.read_file("Documents/hello.txt"))' \
        >/tmp/astra-files.log 2>&1 \
        && grep -qx 'hello from the image' /tmp/astra-files.log; then
        ok "ai-files" "the file tools read a document from the live user's Documents"
    else
        bad "ai-files" "$(tail -n 2 /tmp/astra-files.log | tr '\n' ' ')"
    fi
    rm -rf /tmp/astra-files-smoke
fi
if as_user xset s off >/dev/null 2>&1 \
    && as_user xset s noblank >/dev/null 2>&1 \
    && as_user xset dpms force on >/dev/null 2>&1 \
    && as_user xset -dpms >/dev/null 2>&1 \
    && as_user xset s reset >/dev/null 2>&1 \
    && as_user xrefresh >/dev/null 2>&1; then
    ok "screenshot-ready" "blanking off, display on, screen repainted"
else
    bad "screenshot-ready" "the session could not be asked to unblank and repaint"
fi

# --- result ---------------------------------------------------------------------------
say "checks: $CHECKS, failed: $FAILED"
if [ "$FAILED" -eq 0 ]; then
    say "RESULT: PASS ($CHECKS checks, 0 failed)"
else
    say "RESULT: FAIL ($CHECKS checks, $FAILED failed)"
fi

# Hold the desktop on screen for the screenshot the caller takes from the host, then
# power off. The power-off is the caller's "the guest is finished" signal.
say "holding the session for the screenshot"
sleep 25
sync
say "end"
systemctl poweroff || poweroff || halt -p
