#!/bin/sh
# AstraOS medium identity hook (binary stage).
#
# WHY THIS IS A HOOK AND NOT A CONFIGURATION OPTION
# -------------------------------------------------
# live-build's binary_disk stage writes .disk/info itself, and the name it writes is a
# literal in that script: both the `debian` case and the fallback case set
# TITLE="Debian GNU/Linux", and no lb config option changes it. Only VERSION_ID is read out
# of the chroot, which is why this project's version number appears inside a Debian
# sentence. So the medium announced itself as
#
#   Debian GNU/Linux 0.1.0 "Trixie" - Snapshot amd64 LIVE Binary 20261013-18:47
#
# — a Debian name on an AstraOS image, and the exact string the ISO validator's
# "medium identifies itself as Debian" check refuses.
#
# A binary include would not be overwritten: in the pinned live-build's own `binary` stage
# binary_disk runs BEFORE binary_includes, so config/includes.binary/.disk/info would win.
# A hook is used anyway because the line must carry this build's identity and build stamp,
# which a static file in the repository cannot produce, and because the assertion at the end
# can then fail the build with the file visible. binary_hooks runs after binary_includes and
# before binary_checksums and binary_iso, so this is the last point at which the medium's own
# description of itself can be corrected before it is packed and checksummed.
#
# The file it replaces is generated, not owned by any package, and exists only on the ISO
# surface; nothing inside the live filesystem is touched.

set -eu

# Binary hooks run with the binary/ staging directory as the working directory; the
# chroot tree it was assembled from is its sibling.
PREFIX='[astraos:disk-info]'

log() { printf '%s %s\n' "$PREFIX" "$*"; }
fail() { printf '%s ERROR: %s\n' "$PREFIX" "$*" >&2; exit 1; }

mkdir -p .disk

# The identity comes from the configuration this repository renders, never from literals in
# this file. A build that cannot find it is refused rather than stamped with a guess.
#
# WHERE IT IS LOOKED FOR, AND WHY THERE IS MORE THAN ONE PLACE
# ----------------------------------------------------------
# configure-live-build.sh renders config/distribution.env into the chroot include tree at
# usr/share/astraos/staged/distribution.env, so live-build copies it into the chroot as
# /usr/share/astraos/staged/distribution.env. The chroot tree is the intended source.
#
# This hook never read it. 0600-cleanup.hook.chroot removes /usr/share/astraos/staged so
# that it is not shipped inside the live filesystem, and that runs long before the binary
# stage, so the file was gone by the time this looked for it and the defaults that used to
# sit below were used on every single build. That is how the medium's identity came to be
# free to disagree with the image's own /etc/os-release, and it did: the defaults still
# said 0.1.0 and would have stamped a 0.2.0 image, which the ISO validator compares against
# os-release-derived expectations.
#
# The search covers every tree that can hold the file and every working directory a binary
# hook may be invoked from, because which directory that is is live-build's business and not
# something this repository should have to assume. The first candidate is derived from this
# script's own location, which works from anywhere live-build chooses to stand; the rest are
# the relative paths that work when the hook is invoked without a full path.
IDENTITY=""
for candidate in \
    "$(dirname "$0")/../../includes.chroot/usr/share/astraos/staged/distribution.env" \
    ../chroot/usr/share/astraos/staged/distribution.env \
    chroot/usr/share/astraos/staged/distribution.env \
    config/includes.chroot/usr/share/astraos/staged/distribution.env \
    ../config/includes.chroot/usr/share/astraos/staged/distribution.env
do
    if [ -f "$candidate" ]; then
        IDENTITY="$candidate"
        break
    fi
done

if [ -z "$IDENTITY" ]; then
    fail "no release identity found, so the medium cannot be stamped and this build will
not invent a version. From $(pwd), with this script at $0, none of these existed:
    $(dirname "$0")/../../includes.chroot/usr/share/astraos/staged/distribution.env
    ../chroot/usr/share/astraos/staged/distribution.env
    chroot/usr/share/astraos/staged/distribution.env
    config/includes.chroot/usr/share/astraos/staged/distribution.env
    ../config/includes.chroot/usr/share/astraos/staged/distribution.env
scripts/configure-live-build.sh creates the staged copy; build through scripts/build-iso.sh."
fi

log "release identity: ${IDENTITY}"
# The path is in a variable, so ShellCheck cannot follow it and reports SC1090. The build
# scripts answer that with the same directive.
# shellcheck source=/dev/null
. "$IDENTITY"

# Every field is required, and there are deliberately no defaults. A default is a second copy
# of the release's identity, and this file's copy of the version is exactly what went stale
# while the real one was raised. A missing field stops the build instead, naming itself.
: "${ASTRAOS_NAME:?$IDENTITY did not set ASTRAOS_NAME}"
: "${ASTRAOS_VERSION:?$IDENTITY did not set ASTRAOS_VERSION}"
: "${ASTRAOS_RELEASE_STAGE:?$IDENTITY did not set ASTRAOS_RELEASE_STAGE}"
: "${ASTRAOS_ARCH:?$IDENTITY did not set ASTRAOS_ARCH}"
: "${ASTRAOS_BASE_DISTRIBUTION:?$IDENTITY did not set ASTRAOS_BASE_DISTRIBUTION}"
: "${ASTRAOS_BASE_RELEASE_VERSION:?$IDENTITY did not set ASTRAOS_BASE_RELEASE_VERSION}"

STAMP="$(date -u +%Y%m%d-%H:%M)"

# The base distribution is named on purpose (plan §23: an independent distribution
# based on Debian, never presented as Debian), but the line starts with AstraOS.
printf '%s %s %s (%s, based on %s %s) %s LIVE Binary %s\n' \
    "$ASTRAOS_NAME" "$ASTRAOS_VERSION" "$ASTRAOS_RELEASE_STAGE" \
    "$ASTRAOS_ARCH" "$ASTRAOS_BASE_DISTRIBUTION" "$ASTRAOS_BASE_RELEASE_VERSION" \
    "$ASTRAOS_ARCH" "$STAMP" > .disk/info

# The assertion the ISO validator makes, checked here too: a build that would ship a
# Debian-named medium fails now, in front of the maintainer, with the file visible.
if grep -q '^Debian' .disk/info; then
    fail ".disk/info still identifies the medium as Debian"
fi

log "medium identity: $(cat .disk/info)"
