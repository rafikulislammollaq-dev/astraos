#!/bin/sh
# AstraOS installer validation hook (chroot stage).
#
# The Calamares configuration is installed by the astraos-installer package. This hook
# exists to VALIDATE it, because a settings.conf that names a module which is not
# installed produces an installer that fails on its final screen - exactly the defect
# plan §10.1 warns about. Validating here means a broken installer cannot be shipped.
#
# Nothing in this hook writes the configuration; if the package is wrong, the build
# fails rather than being silently repaired.

set -eu

PREFIX='[astraos:installer]'

log() { printf '%s %s\n' "$PREFIX" "$*"; }
fail() { printf '%s ERROR: %s\n' "$PREFIX" "$*" >&2; exit 1; }

# --- Presence -----------------------------------------------------------------
[ -x /usr/bin/calamares ] || fail "calamares is not installed"
[ -f /etc/calamares/settings.conf ] || fail "the astraos-installer package did not install /etc/calamares/settings.conf"
[ -d /usr/share/calamares/branding/astraos ] || fail "the Calamares AstraOS branding directory is missing"
log "calamares installed and configured"

# --- Module directory ---------------------------------------------------------
MODULE_DIRS=""
for candidate in /usr/lib/x86_64-linux-gnu/calamares/modules \
                 /usr/lib/calamares/modules \
                 /usr/lib64/calamares/modules; do
    [ -d "$candidate" ] && MODULE_DIRS="${MODULE_DIRS} ${candidate}"
done
[ -n "${MODULE_DIRS}" ] || fail "cannot find the Calamares module directory; the installer cannot be validated"
log "module directories:${MODULE_DIRS}"

# --- Extract the module sequence ----------------------------------------------
# Calamares 3.x settings.conf is YAML: the module sequence is a list of plain scalar
# entries nested under `- show:` / `- exec:` steps, for example:
#
#   sequence:
#   - show:
#     - welcome
#     - locale
#   - exec:
#     - partition
#
# The pattern below matches only lines that are a list item with a bare word, which
# excludes the step keys themselves ("- show:" contains a colon) and every other YAML
# key. A parser that looked for the old "modules:" key would find nothing on
# Calamares 3.x and silently pass, so this shape is checked for explicitly.
MODULES="$(grep -E '^[[:space:]]+-[[:space:]]+[A-Za-z0-9_][A-Za-z0-9_-]*[[:space:]]*$' \
    /etc/calamares/settings.conf | sed -E 's/^[[:space:]]+-[[:space:]]+//; s/[[:space:]]+$//')"

[ -n "${MODULES}" ] || fail "no module sequence could be parsed from /etc/calamares/settings.conf (expected a YAML 'sequence:' list)"

# The sequence must contain the steps a usable installer cannot omit.
for step in partition summary users bootloader; do
    if printf '%s\n' "$MODULES" | grep -qx -- "$step"; then
        printf '%s ok    sequence includes %s\n' "$PREFIX" "$step"
    else
        fail "the Calamares sequence does not include the '${step}' step; the installer would be incomplete"
    fi
done

MISSING=0
COUNT=0
for entry in $MODULES; do
    name="$(printf '%s' "$entry" | sed 's/^[a-z-]*://')"
    [ -n "$name" ] || continue
    COUNT=$((COUNT + 1))
    found=no
    for dir in ${MODULE_DIRS}; do
        if [ -d "${dir}/${name}" ]; then found=yes; break; fi
    done
    if [ "$found" = yes ]; then
        printf '%s ok    module %s\n' "$PREFIX" "$name"
    else
        printf '%s FAIL  module %s is referenced by settings.conf but is not installed\n' "$PREFIX" "$name" >&2
        MISSING=$((MISSING + 1))
    fi
done

if [ "$MISSING" -gt 0 ]; then
    fail "${MISSING} of ${COUNT} Calamares module(s) missing. The installer would fail; refusing to build."
fi
log "all ${COUNT} configured Calamares modules are installed"

# --- Module search path --------------------------------------------------------
# The loop above proves the modules exist; it cannot prove Calamares will look for
# them where they are. Settings.cpp passes `modules-search` straight to the module
# search paths, so a settings file without the key searches nowhere and the installer
# opens on "Calamares Initialization Failed" before drawing a page. The install
# exercise for this release died exactly there (run 38940011841) on an image this hook
# had passed, because presence on disk is not the same as being in the search path.
# Require the list, and require one of its entries to really carry modules.
SEARCH="$(sed -n 's/^modules-search:[[:space:]]*\[\(.*\)\].*/\1/p' /etc/calamares/settings.conf)"
[ -n "${SEARCH}" ] \
    || fail "settings.conf has no modules-search list; Calamares would search no directory at all and open on its initialization error dialog"

search_ok=no
for entry in $(printf '%s' "${SEARCH}" | tr ',' ' '); do
    if [ "${entry}" = local ]; then
        # `local` is resolved by Calamares to the install prefix's lib directory, and
        # MODULE_DIRS is what that directory is on this system.
        dirs="${MODULE_DIRS}"
    else
        dirs="${entry}"
    fi
    for dir in ${dirs}; do
        if [ -d "${dir}/welcome" ] && [ -d "${dir}/unpackfs" ]; then
            search_ok=yes
        fi
    done
done
[ "${search_ok}" = yes ] \
    || fail "modules-search names no directory that holds the Calamares modules (entries: ${SEARCH})"
log "modules-search names a directory that holds the modules"

# --- Branding sanity ----------------------------------------------------------
# The files the branding descriptor references must exist next to it: Calamares 3.3
# exits at the branding constructor when an image or the slideshow file is missing, so
# a package that ships a descriptor without its assets is not shippable.
for asset in branding.desc logo.png welcome.png; do
    [ -f "/usr/share/calamares/branding/astraos/${asset}" ] \
        || fail "installer branding asset is missing: ${asset}"
done
log "installer branding assets present"

# Calamares 3.3's branding constructor parses `slideshow` unconditionally — even with
# no `show` module in the sequence — and a missing key is fatal before the installer
# draws its first page. The first CI install attempt died exactly there (run
# 38924527286: "key not found: slideshow"), after earlier builds had shipped the same
# descriptor without anything ever starting the installer. The component name is
# checked for the same reason: Calamares refuses a branding directory whose
# componentName does not match the directory name.
BRANDING_DESC=/usr/share/calamares/branding/astraos/branding.desc
grep -qsE '^componentName:[[:space:]]*astraos[[:space:]]*$' "$BRANDING_DESC" \
    || fail "branding.desc does not declare componentName: astraos (Calamares refuses a component whose name does not match its directory)"

SLIDESHOW_FILES="$(sed -n '/^slideshow:/,/^[^[:space:]]/p' "$BRANDING_DESC" \
    | grep -oE '[A-Za-z0-9._-]+\.(png|jpg|jpeg|qml)' | sort -u || true)"
[ -n "${SLIDESHOW_FILES}" ] \
    || fail "branding.desc has no usable 'slideshow' value; Calamares 3.3 refuses to start the installer without one"
for file in ${SLIDESHOW_FILES}; do
    [ -f "/usr/share/calamares/branding/astraos/${file}" ] \
        || fail "branding.desc names a slideshow file that does not exist: ${file}"
done
log "slideshow files present: $(printf '%s' "${SLIDESHOW_FILES}" | tr '\n' ' ')"

# --- Disk-safety policy -------------------------------------------------------
# Calamares does the partitioning. These assertions encode plan §10.3 and Rule 9:
# the installer must never pre-authorise erasing a disk, and it must always show the
# user which partitions it is going to touch.
PARTITION_CONF=/etc/calamares/modules/partition.conf
[ -f "$PARTITION_CONF" ] || fail "partition.conf is missing; the installer would have no partitioning policy"

# The pattern is `none`, and that is a correction rather than a preference. Calamares
# 3.3's Config::installChoiceNames() knows exactly
#     none, nochoice, alongside, erase, replace, manual
# and installChoiceNames().find() falls back to the FIRST entry of that table - "none" -
# for a name it does not know, silently for this key. An assertion looking for the string
# `eraseDisk` could therefore never fire: that spelling is not a choice Calamares is able
# to make, so a partition.conf carrying it erases nothing. The value that authorises
# erasure is `erase`. Requiring `none` catches that one, and every other spelling with it.
if ! grep -qsE '^initialPartitioningChoice:[[:space:]]*none[[:space:]]*$' "$PARTITION_CONF"; then
    fail "partition.conf's default partitioning choice is not 'none'; the installer must not pre-authorise erasing a disk"
fi
printf '%s ok    the default partitioning choice is none: nothing is erased without a choice\n' "$PREFIX"

if grep -qsE '^alwaysShowPartitionLabels:[[:space:]]*true' "$PARTITION_CONF"; then
    printf '%s ok    partition labels are always shown to the user\n' "$PREFIX"
else
    fail "alwaysShowPartitionLabels is not enabled in partition.conf; the user must see which partitions are affected"
fi

# The value is allowed to be quoted. `defaultFileSystemType: "ext4"` and
# `defaultFileSystemType: ext4` are the same YAML string, the shipped file uses the quoted
# form, and a pattern that accepted only one of them failed the build once. Both spellings
# are therefore matched deliberately, and tests/static/test_hook_assertions.py pins this
# pattern against the file the repository ships.
if grep -qsE '^defaultFileSystemType:[[:space:]]*"?ext4"?' "$PARTITION_CONF"; then
    printf '%s ok    default root filesystem is ext4\n' "$PREFIX"
else
    fail "partition.conf does not select ext4 as the default root filesystem (plan §11)"
fi

# --- Credentials policy --------------------------------------------------------
# The Calamares users module must not ship an autologin or a preset password, must not
# offer to set a root password (plan §13.1), and must not accept an empty password: the
# module's own passwordStatus() treats "no requirements configured" as "the empty
# string is valid", so the requirement has to be stated explicitly.
if grep -rqs 'autologinUser' /etc/calamares/modules/ 2>/dev/null; then
    if grep -rqsE 'autologinUser:[[:space:]]*[^"'"'"'[:space:]]' /etc/calamares/modules/ 2>/dev/null; then
        fail "a Calamares module configures an autologin user; AstraOS must not ship fixed credentials"
    fi
fi

USERS_CONF=/etc/calamares/modules/users.conf

if grep -rqsE '^\s*password:' "$USERS_CONF" 2>/dev/null; then
    fail "users.conf appears to contain a fixed password"
fi

if grep -qsE '^setRootPassword:[[:space:]]*false' "$USERS_CONF"; then
    printf '%s ok    root stays disabled for login on the target\n' "$PREFIX"
else
    fail "users.conf does not set setRootPassword: false; the installer would offer a root password even though the root account must stay disabled (plan §13.1)"
fi

# Two plain greps, not one with context: `grep -A4E` is read by GNU grep as `-A 4E`
# ("invalid context length argument"), the error goes to /dev/null, and the assertion
# then refuses a correct image - run 38909791960 died at the end of the chroot stage on
# exactly that spelling. Both patterns are pinned against this repository's users.conf
# by tests/static/test_hook_assertions.py, which also refuses the flag shape everywhere.
if grep -qsE '^passwordRequirements:' "$USERS_CONF" \
        && grep -qsE '^[[:space:]]+minLength:[[:space:]]*[1-9][0-9]*[[:space:]]*$' "$USERS_CONF"; then
    printf '%s ok    an empty password is not accepted (minLength >= 1)\n' "$PREFIX"
else
    fail "users.conf does not require a non-empty password (passwordRequirements: minLength >= 1); the users module accepts an empty password when no requirements are configured"
fi

# --- Bootloader module --------------------------------------------------------
# A module config in /etc/calamares/modules REPLACES Calamares' own, it does not extend it:
# Calamares reads one file per module, first at /etc/calamares/modules, then at
# /usr/share/calamares/modules. So a key the module reads with no default has to be stated
# in the file this repository ships, and a missing one is not a default - it is a KeyError
# part-way through an installation, on a machine that has already had its filesystems
# written.
#
# And on THIS image the second of those two paths is empty. That is what the Mount section
# further down had to learn the hard way: the project installs upstream's `calamares` and
# deliberately not `calamares-settings-debian`, which is where Debian's own /etc/calamares
# tree comes from (config/package-lists/60-installer.list.chroot explains that choice, and
# it is the right one). Calamares' own output in run 39233194012 says what it costs:
#
#   WARNING: No config file for "mount" found anywhere at
#   "/src/modules/mount/mount.conf" "/etc/calamares/modules/mount.conf"
#   "/usr/share/calamares/modules/mount.conf"
#
# A module config this repository does not ship is not a packaged default. It is nothing.
#
# This assertion did not exist, and run 39230792183 is what that cost: the installer filled
# the filesystems, reached job 26 of 27, and died on
#
#   ERROR: Error while running: KeyError: 'grubInstall'
#     main.py(654): run_grub_install <- (717): install_grub <- (897): prepare_bootloader
#
# The four keys after it on the same path (main.py lines 779, 719, 748 and 459) would have
# fired in turn, one per attempt. All six below are the keys Calamares 3.3.14's own
# bootloader.conf ships, which is the configuration upstream tests; the image is refused
# if this repository's copy omits any of them.
BOOTLOADER_CONF=/etc/calamares/modules/bootloader.conf
[ -f "$BOOTLOADER_CONF" ] \
    || fail "bootloader.conf is missing; the installer would install no bootloader at all"
BOOTLOADER_MISSING=""
for key in efiBootLoader grubInstall grubMkconfig grubCfg grubProbe efiBootMgr; do
    grep -qsE "^${key}:[[:space:]]*[^[:space:]]" "$BOOTLOADER_CONF" \
        || BOOTLOADER_MISSING="${BOOTLOADER_MISSING} ${key}"
done
if [ -n "${BOOTLOADER_MISSING}" ]; then
    fail "bootloader.conf does not state:${BOOTLOADER_MISSING}. Calamares' bootloader module reads these with no default, so the installation would stop with a KeyError instead of installing a bootloader"
fi
printf '%s ok    bootloader.conf states every key the bootloader module reads without a default\n' "$PREFIX"

# --- Mount module ------------------------------------------------------------
# THE ONE THAT MAKES THE TARGET A CHROOT. A copy of Calamares' own mount.conf, because
# nothing else in this image supplies one, and its `extraMounts` is the only thing that
# puts /dev, /proc, /sys and /run inside the target before the destructive phase runs.
#
# Run 39233194012 reached job 26 of 27 with twenty-five jobs already written to the disk,
# and stopped:
#
#   .. Running QList("grub-install", "--target=i386-pc", "--recheck", "--force", "/dev/vda")
#   grub-install: error: cannot find a device for /boot/grub (is /dev mounted?)
#   ERROR: Installation failed: "Bootloader installation error"
#
# So this assertion is not "the file exists". The file did not exist, and nothing said so:
# it is the four mounts that make the difference between a target Calamares can chroot into
# and one it cannot, checked because they are the difference.
MOUNT_CONF=/etc/calamares/modules/mount.conf
[ -f "$MOUNT_CONF" ] \
    || fail "mount.conf is missing. Nothing else in this image supplies one, so the mount module would run with an empty configuration, the target would have no /dev, /proc, /sys or /run, and the installation would die at the bootloader - which is exactly what run 39233194012 recorded"
MOUNT_MISSING=""
for point in /proc /sys /dev /run; do
    grep -qsE "^[[:space:]]*mountPoint:[[:space:]]*${point}[[:space:]]*$" "$MOUNT_CONF" \
        || MOUNT_MISSING="${MOUNT_MISSING} ${point}"
done
if [ -n "${MOUNT_MISSING}" ]; then
    fail "mount.conf has no extraMounts entry for:${MOUNT_MISSING}. Calamares mounts these into the target from this list and from nowhere else; without them grub-install cannot find a device for /boot/grub"
fi
printf '%s ok    mount.conf mounts the special filesystems into the target\n' "$PREFIX"

# --- fstab module ------------------------------------------------------------
# The harmless case of the same mistake. This module reads every one of its keys with a
# default, so job 12 of 27 ran in run 39233194012 and wrote a usable /etc/fstab - but the
# default it substitutes is not Debian's, and Debian is what this distribution installs.
# A plain `luks` crypttab entry is not something Debian's cryptsetup-initramfs can unlock.
FSTAB_CONF=/etc/calamares/modules/fstab.conf
[ -f "$FSTAB_CONF" ] \
    || fail "fstab.conf is missing; the fstab module would write a plain-luks crypttab entry, which Debian's cryptsetup-initramfs cannot use to unlock an encrypted root filesystem"
grep -qsE '^crypttabOptions:[[:space:]]*luks,keyscript=/bin/cat[[:space:]]*$' "$FSTAB_CONF" \
    || fail "fstab.conf does not set crypttabOptions: luks,keyscript=/bin/cat, which Calamares' own fstab.conf names as the value Debian and Debian-based distributions need"
printf '%s ok    fstab.conf writes the crypttab options Debian needs\n' "$PREFIX"

log "installer configuration validated"
