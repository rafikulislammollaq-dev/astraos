# ---- Build artifacts (never committed by default, per plan §4) ----
#
# These patterns are deliberately anchored. An unanchored rule such as `live-build/`
# would also hide the real source directory config/live-build/, which is tracked.
# Everything generated by a build lives under build/ or dist/.

/build/*
!/build/.gitkeep
/dist/*
!/dist/.gitkeep

# live-build working trees (only ever created inside build/)
/build/live-build/auto/
/build/live-build/config/
/build/live-build/binary/
/build/live-build/binary.hybrid/
/build/live-build/cache/
/build/live-build/chroot/
/build/live-build/chroot_archives/
/build/live-build/.build/
/build/live-build/.stage/
/build/live-build/*.iso
/build/live-build/*.contents
/build/live-build/*.files
/build/live-build/*.packages
/build/live-build/*.squashfs
/build/cache/

# Generated ISOs and images anywhere in the tree
/*.iso
/*.img
/dist/**/*.iso
/dist/**/*.img
/dist/**/*.squashfs
/dist/**/*.filesystem.*
/dist/**/*.packages

# Generated asset scratch space (sources live in branding/)
/branding/generated/tmp/

# ---- Logs (may contain host paths; never commit) ----
*.log
/logs/
*.buildlog

# ---- Third-party reference material ----
# Design reference screenshots of unknown provenance. They document the visual target for
# maintainers but nothing in the build, the tests or the image needs them, so they are not
# published. Keep the files locally; see docs/DESIGN.md for the written design tokens.
/docs/reference/

# ---- Secrets: never commit these ----
.env
.env.*
!.env.example
*.key
*.pem
*.asc
id_rsa*
*.token
secrets/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
